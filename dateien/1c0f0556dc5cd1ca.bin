ha":1,"color_bg_variation":"harmonic","color_bg_custom":"","color_border":"inherit","color_border_type":"auto","color_border_alpha":1,"color_border_variation":"harmonic","color_border_custom":"","bg_image_src":"","bg_image_arrangement":"centerCenter","overlay_type":"none","overlay_gradient_direction":"vertical","overlay_gradient_color1":"key1","overlay_gradient_opacity1":10,"overlay_gradient_color2":"dark","overlay_gradient_opacity2":30,"overlay_solid_color":"black","overlay_solid_opacity":30,"border_width":"default","border_width_custom":1,"border_type":"solid","radius_key":"4","radius_custom":4,"align_vertical":"top","padding_key":"xl","padding_custom":48,"shadow_key":"none","shadow_x":0,"shadow_y":8,"shadow_blur":40,"shadow_spreed":0,"shadow_opacity":0.15,"align_horizontal":"left","bg_image_position":[50,50]},"data":{},"type":"base","moleculeModel":"text-block","children":[],"atoms":[{"_id":"e8e887b5-0ac4-4e89-b2ff-b3b205d01b02","position":1,"type":"header","data":{"text":{"blocks":[{"key":"8m1sv","text":"Das am meisten unterschätzte ","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{"align_horizontal":"center"}},{"key":"fs1v8","text":"Element im Online-Marketing","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{"align_horizontal":"center"}}],"entityMap":{}}},"styles":{"atom_width":100,"indentLg":50,"font_type":"l"}},{"_id":"099d9731-bf72-4b79-87b6-884d68f25186","position":2,"type":"plain-text","data":{"text":{"blocks":[{"key":"8r4b3","text":" ...und wie du es zu deinem entscheidenden Vorteil machst.","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}},{"key":"1vjf5","text":"Im klassischen Handel ist längst klar: Je besser das Vertriebsteam Interessenten begeistert, desto besser läuft das Geschäft. Im Online-Marketing gibt es jedoch selten Verkäufer, die potenzielle Kunden begeistern. Es gibt primär deinen Online-Auftritt.","type":"unstyled","depth":0,"inlineStyleRanges":[{"offset":39,"length":85,"style":"BOLD"}],"entityRanges":[{"offset":39,"length":85,"key":0}],"data":{}},{"key":"ed7np","text":"Du hast nur wenige Sekunden der Aufmerksamkeit deiner Zielgruppe. Hier entscheidet sich, ob sie weiterlesen oder beim Mitbewerber landen. Doch was machen die meisten in deiner Branche? Die Texte sind irgendwann auf die Schnelle geschrieben und danach nie wieder beachtet worden. Sie sind Mist.","type":"unstyled","depth":0,"inlineStyleRanges":[{"offset":138,"length":46,"style":"BOLD"}],"entityRanges":[{"offset":138,"length":46,"key":1}],"data":{}},{"key":"bc94n","text":"Oder noch schlimmer: Eine Agentur hat die Texte für dich verfasst und deine einzigartige DNA ist kaum noch zu erkennen. Diesen Zeilen einen Feinschliff zu verpassen, verwandelt skeptische Besucher in begeisterte Anfragen.","type":"unstyled","depth":0,"inlineStyleRanges":[{"offset":119,"length":102,"style":"BOLD"}],"entityRanges":[{"offset":120,"length":101,"key":2}],"data":{}},{"key":"6pt11","text":"Und je intensiver deine Texte potenzielle Kunden begeistern, desto mehr Menschen entschließen sich, bei dir Geld zu lassen. Viel Geld. ","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}},{"key":"bn29b","text":"Genau diese Texte schreibe ich für dich.","type":"unstyled","depth":0,"inlineStyleRanges":[{"offset":0,"length":40,"style":"BOLD"}],"entityRanges":[{"offset":31,"length":9,"key":3}],"data":{}}],"entityMap":{"0":{"type":"LINK","mutability":"MUTABLE","data":{"highlight_type":"underline","color_bg_alpha":1,"radius_key":"8","type":"link","highlight_id":"3O88hYoZIE5CY4v58ya3Z","color_bg_variation":"contrast","color_bg_custom":"255,170,3","color_bg_type":"custom","border_width":"4","color_border_variation":"text","color_border_type":"palette","color_border":"key1"}},"1":{"type":"LINK","mutability":"MUTABLE","data":{"highlight_type":"underline","type":"link","highlight_id":"eZMkOuuAmGGVqQmRVCTcs","border_width":"4"}},"2":{"type":"LINK","mutability":"MUTABLE","data":{"highlight_type":"underline","type":"link","highlight_id":"pvE53gIaBoJ3aAL-Ywc2Y","color_border_variation":"contrast","border_width":"4"}},"3":{"type":"LINK","mutability":"MUTABLE","data":{"highlight_type":"hand-underlined","type":"link","highlight_id":"ETmU0NX-i6u30jfu9zhim","border_width":"3"}}}}},"styles":{"font_type":"xl","atom_width":100}}]}],"position":8,"type":"default","layer":{"_id":"5jIZyr0kq2JE1p5Df5P_f","type":"flex","data":{},"styles":{},"frames":[{"_id":"padAnfSnwuskXR5NoBecm","position":1,"data":{},"styles":{},"type":"default","rows":[{"_id":"D0bxy5VGAvHncxTOX-9SQ","position":1,"data":{},"styles":{},"molecules":[{"_id":"ufW3gmSm_ep5GYbdorcNv","position":1,"styles":{"layout_column":24,"style_type":"transparent","color_text":"inherit","color_text_type":"auto","color_text_alpha":1,"color_text_variation":"text","color_text_custom":"","color_bg":"inherit","color_bg_type":"auto","color_bg_alpha":1,"color_bg_variation":"harmonic","color_bg_custom":"","color_border":"inherit","color_border_type":"auto","color_border_alpha":1,"color_border_variation":"harmonic","color_border_custom":"","bg_image_src":"","bg_image_arrangement":"centerCenter","overlay_type":"none","overlay_gradient_direction":"vertical","overlay_gradient_color1":"key1","overlay_gradient_opacity1":10,"overlay_gradient_color2":"dark","overlay_gradient_opacity2":30,"overlay_solid_color":"black","overlay_solid_opacity":30,"border_width":"default","border_width_custom":1,"border_type":"solid","radius_key":"4","radius_custom":4,"align_vertical":"top","padding_key":"xl","padding_custom":48,"shadow_key":"none","shadow_x":0,"shadow_y":8,"shadow_blur":40,"shadow_spreed":0,"shadow_opacity":0.15,"align_horizontal":"left","bg_image_position":[50,50]},"data":{},"type":"base","moleculeModel":"text-block","children":[],"atoms":[{"_id":"1a8e988a-deca-49cc-bcbb-d16dc44ba5ac","type":"custom-code","position":2,"data":{"html":"\u003C!DOCTYPE html\u003E\r\n\u003Chtml lang=\"de\"\u003E\r\n\u003Chead\u003E\r\n\u003Cmeta charset=\"UTF-8\"\u003E\r\n\u003Cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"\u003E\r\n\u003Ctitle\u003E3-Step Timeline\u003C\u002Ftitle\u003E\r\n\u003Clink rel=\"preconnect\" href=\"https:\u002F\u002Ffonts.googleapis.com\"\u003E\r\n\u003Clink rel=\"stylesheet\" href=\"https:\u002F\u002Ffonts.googleapis.com\u002Fcss2?family=Cormorant+Garamond:wght@400;600&family=Montserrat:wght@600;700;800&family=DM+Sans:wght@400;500&display=swap\"\u003E\r\n\u003Cstyle\u003E\r\n\u002F* ── Reset ── *\u002F\r\n*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\r\n\r\n\u002F* ── Variables ── *\u002F\r\n:root {\r\n  --c-void:        #0A0A0A;\r\n  --c-void-lift:   #141414;\r\n  --c-gold:        #C9A84C;\r\n  --c-gold-border: rgba(201,168,76,0.30);\r\n  --c-gold-subtle: rgba(201,168,76,0.12);\r\n  --c-headline:    #F5F0E8;\r\n  --c-body:        #A8A9AD;\r\n  --c-body-soft:   #7A7B7F;\r\n  --c-divider:     rgba(168,169,173,0.18);\r\n  --f-display:     'Cormorant Garamond', Georgia, serif;\r\n  --f-headline:    'Montserrat', sans-serif;\r\n  --f-body:        'DM Sans', sans-serif;\r\n}\r\n\r\nbody { background: var(--c-void); }\r\n\r\n\u002F* ── Section ── *\u002F\r\n.tl-section {\r\n  background: var(--c-void);\r\n  padding: 96px 0;\r\n  font-family: var(--f-body);\r\n  color: var(--c-body);\r\n}\r\n.tl-inner {\r\n  max-width: 1280px;\r\n  margin: 0 auto;\r\n  padding: 0 48px;\r\n}\r\n\r\n\u002F* ── Headline ── *\u002F\r\n.tl-hd { text-align: center; margin-bottom: 88px; }\r\n.tl-hd h2 {\r\n  font-family: var(--f-headline);\r\n  font-size: clamp(1.8rem, 3vw, 2.5rem);\r\n  font-weight: 700;\r\n  color: var(--c-headline);\r\n  line-height: 1.2;\r\n  margin-bottom: 16px;\r\n}\r\n.tl-hd p {\r\n  font-size: 1.1rem;\r\n  color: var(--c-body);\r\n  max-width: 580px;\r\n  margin: 0 auto;\r\n  line-height: 1.65;\r\n}\r\n\r\n\u002F* ── Vertical connector ── *\u002F\r\n.tl-body { position: relative; }\r\n.tl-body::before {\r\n  content: '';\r\n  position: absolute; left: 50%; top: 28px; bottom: 28px;\r\n  width: 1px; transform: translateX(-50%);\r\n  background: linear-gradient(180deg, rgba(201,168,76,0.30) 0%, rgba(201,168,76,0.04) 100%);\r\n}\r\n\r\n\u002F* ── Step grid ── *\u002F\r\n.tl-step {\r\n  display: grid;\r\n  grid-template-columns: 1fr 100px 1fr;\r\n  align-items: center;\r\n  margin-bottom: 80px;\r\n  position: relative;\r\n}\r\n.tl-step:last-child { margin-bottom: 0; }\r\n\r\n\u002F* Odd: text left, anim right *\u002F\r\n.tl-step:nth-child(odd)  .tl-content { grid-column: 1; text-align: left; padding: 0 48px 0 0; }\r\n.tl-step:nth-child(odd)  .tl-node    { grid-column: 2; }\r\n.tl-step:nth-child(odd)  .tl-anim    { grid-column: 3; display: flex; justify-content: flex-start; padding-left: 48px; }\r\n\u002F* Even: anim left, text right *\u002F\r\n.tl-step:nth-child(even) .tl-anim    { grid-column: 1; display: flex; justify-content: flex-end; padding-right: 48px; }\r\n.tl-step:nth-child(even) .tl-node    { grid-column: 2; }\r\n.tl-step:nth-child(even) .tl-content { grid-column: 3; text-align: left;  padding: 0 0 0 48px; }\r\n\r\n\u002F* ── Node ── *\u002F\r\n.tl-node { display: flex; align-items: center; justify-content: center; z-index: 2; }\r\n.tl-ring {\r\n  width: 58px; height: 58px; border-radius: 50%;\r\n  background: var(--c-void); border: 2px solid var(--c-gold);\r\n  display: flex; align-items: center; justify-content: center;\r\n  font-family: var(--f-headline); font-size: 13px; font-weight: 700; color: var(--c-gold);\r\n  box-shadow: 0 0 0 8px rgba(201,168,76,0.06), 0 0 28px rgba(201,168,76,0.18);\r\n  transition: box-shadow 0.4s, transform 0.4s;\r\n}\r\n.tl-step:hover .tl-ring {\r\n  box-shadow: 0 0 0 12px rgba(201,168,76,0.1), 0 0 40px rgba(201,168,76,0.3);\r\n  transform: scale(1.08);\r\n}\r\n\r\n\u002F* ── Content ── *\u002F\r\n.tl-content h3 {\r\n  font-family: var(--f-headline); font-size: 1.15rem;\r\n  font-weight: 700; color: var(--c-headline);\r\n  line-height: 1.3; margin-bottom: 14px;\r\n}\r\n.tl-content p {\r\n  font-size: 15px; color: var(--c-body);\r\n  line-height: 1.65; white-space: pre-line;\r\n}\r\n.tl-content strong { color: var(--c-headline); font-weight: 600; }\r\n.tl-content em { color: var(--c-headline); font-style: italic; }\r\n\r\n\u002F* ── Animation box ── *\u002F\r\n.anim-box {\r\n  width: 200px; height: 155px;\r\n  background: var(--c-void-lift);\r\n  border: 1px solid var(--c-divider);\r\n  border-radius: 8px; overflow: hidden;\r\n  position: relative; flex-shrink: 0;\r\n  transition: border-color 0.3s, box-shadow 0.3s;\r\n}\r\n.tl-step:hover .anim-box {\r\n  border-color: var(--c-gold-border);\r\n  box-shadow: 0 0 12px rgba(201,168,76,0.20);\r\n}\r\n\r\n\u002F* ─────────────────────────────\r\n   ANIM 1 · Countdown Timer\r\n───────────────────────────── *\u002F\r\n.ab-timer { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; }\r\n.ab-timer-svg { width: 110px; height: 110px; }\r\n.ab-timer-track { fill: none; stroke: rgba(168,169,173,0.1); stroke-width: 7; }\r\n.ab-timer-ring {\r\n  fill: none; stroke-width: 7; stroke-linecap: round;\r\n  stroke-dasharray: 270; stroke-dashoffset: 0;\r\n  transform-origin: center; transform: rotate(-90deg);\r\n  animation: timerRing 3s linear infinite;\r\n}\r\n@keyframes timerRing {\r\n  0%   { stroke-dashoffset: 0;   stroke: #C9A84C; }\r\n  60%  {                          stroke: #e88c4a; }\r\n  100% { stroke-dashoffset: 270; stroke: #e84a4a; }\r\n}\r\n.ab-timer-num {\r\n  font-family: 'Cormorant Garamond', serif; font-size: 38px; font-weight: 600;\r\n  fill: var(--c-headline); text-anchor: middle; dominant-baseline: central;\r\n}\r\n.ab-timer-sub {\r\n  font-family: 'DM Sans', sans-serif; font-size: 9px; letter-spacing: 0.1em;\r\n  fill: var(--c-body-soft); text-anchor: middle;\r\n}\r\n\r\n\u002F* ─────────────────────────────\r\n   ANIM 2 · Browser Scan\r\n───────────────────────────── *\u002F\r\n.ab-bar {\r\n  height: 26px; background: rgba(255,255,255,0.03);\r\n  border-bottom: 1px solid rgba(255,255,255,0.06);\r\n  display: flex; align-items: center; gap: 5px; padding: 0 10px;\r\n}\r\n.ab-dot { width: 7px; height: 7px; border-radius: 50%; }\r\n.ab-dot:nth-child(1) { background: rgba(255,95,87,0.6); }\r\n.ab-dot:nth-child(2) { background: rgba(255,189,46,0.6); }\r\n.ab-dot:nth-child(3) { background: rgba(40,200,64,0.6); }\r\n.ab-url { flex: 1; height: 14px; margin: 0 8px; background: rgba(255,255,255,0.05); border-radius: 3px; }\r\n.ab-lines { padding: 12px 14px; display: flex; flex-direction: column; gap: 7px; }\r\n.ab-line {\r\n  height: 5px; border-radius: 3px; background: rgba(168,169,173,0.12);\r\n  animation: abScan 3.5s ease-in-out infinite;\r\n}\r\n.ab-line:nth-child(1) { width: 75%; animation-delay: 0.10s; }\r\n.ab-line:nth-child(2) { width: 55%; animation-delay: 0.35s; }\r\n.ab-line:nth-child(3) { width: 88%; animation-delay: 0.60s; }\r\n.ab-line:nth-child(4) { width: 42%; animation-delay: 0.85s; }\r\n.ab-line:nth-child(5) { width: 66%; animation-delay: 1.10s; }\r\n@keyframes abScan {\r\n  0%   { opacity: 0.12; background: rgba(168,169,173,0.12); }\r\n  20%  { opacity: 1;    background: rgba(201,168,76,0.5); }\r\n  50%  { opacity: 0.8;  background: rgba(201,168,76,0.2); }\r\n  100% { opacity: 0.12; background: rgba(168,169,173,0.12); }\r\n}\r\n.ab-cursor {\r\n  position: absolute; bottom: 22px; right: 28px; width: 10px; height: 13px;\r\n  background: var(--c-gold);\r\n  clip-path: polygon(0 0, 100% 38%, 56% 56%, 38% 100%, 0 0);\r\n  animation: abCursor 3.5s ease-in-out infinite;\r\n}\r\n@keyframes abCursor {\r\n  0%   { transform: translate(0,0);         opacity: 0; }\r\n  8%   { opacity: 1; }\r\n  30%  { transform: translate(-38px,-44px); }\r\n  60%  { transform: translate(-75px,-22px); }\r\n  88%  { transform: translate(-50px,-55px); opacity: 1; }\r\n  100% { transform: translate(-50px,-55px); opacity: 0; }\r\n}\r\n\r\n\u002F* ─────────────────────────────\r\n   ANIM 3 · Kalender-Buchung ✓\r\n───────────────────────────── *\u002F\r\n.ab-booked {\r\n  display: flex; align-items: center; justify-content: center;\r\n  flex-direction: column; gap: 10px; width: 100%; height: 100%;\r\n}\r\n.ab-cal {\r\n  width: 136px; height: 96px;\r\n  border: 1.5px solid rgba(168,169,173,0.18); border-radius: 6px;\r\n  overflow: hidden; position: relative;\r\n}\r\n.ab-cal-hd {\r\n  height: 24px; background: var(--c-gold-subtle);\r\n  border-bottom: 1px solid var(--c-gold-border);\r\n  display: flex; align-items: center; justify-content: center;\r\n}\r\n.ab-cal-ttl { font-size: 9px; color: var(--c-gold); font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }\r\n.ab-slots { padding: 8px 10px; display: grid; grid-template-columns: repeat(4,1fr); gap: 5px; }\r\n.ab-slot { height: 13px; border-radius: 2px; background: rgba(168,169,173,0.08); }\r\n.ab-slot-active { animation: slotPop 3s ease-in-out infinite; }\r\n@keyframes slotPop {\r\n  0%,35%  { background: rgba(168,169,173,0.08); }\r\n  55%,80% { background: rgba(201,168,76,0.35); box-shadow: 0 0 6px rgba(201,168,76,0.25); }\r\n  100%    { background: rgba(168,169,173,0.08); }\r\n}\r\n.ab-check-circle {\r\n  position: absolute; top: 50%; left: 50%;\r\n  transform: translate(-50%,-50%);\r\n  width: 42px; height: 42px; border-radius: 50%;\r\n  background: rgba(201,168,76,0.1); border: 2px solid var(--c-gold);\r\n  display: flex; align-items: center; justify-content: center;\r\n  animation: checkCircle 3s ease-in-out infinite;\r\n}\r\n@keyframes checkCircle {\r\n  0%,30%  { opacity: 0; transform: translate(-50%,-50%) scale(0.4); }\r\n  52%,82% { opacity: 1; transform: translate(-50%,-50%) scale(1); box-shadow: 0 0 16px rgba(201,168,76,0.3); }\r\n  100%    { opacity: 0; transform: translate(-50%,-50%) scale(0.4); }\r\n}\r\n.ab-check-svg { width: 22px; height: 22px; }\r\n.ab-check-path {\r\n  fill: none; stroke: var(--c-gold); stroke-width: 2.5;\r\n  stroke-linecap: round; stroke-linejoin: round;\r\n  stroke-dasharray: 24; stroke-dashoffset: 24;\r\n  animation: checkDraw 3s ease-in-out infinite;\r\n}\r\n@keyframes checkDraw {\r\n  0%,32%  { stroke-dashoffset: 24; }\r\n  58%,82% { stroke-dashoffset: 0; }\r\n  100%    { stroke-dashoffset: 24; }\r\n}\r\n.ab-booked-lbl {\r\n  font-size: 9px; color: var(--c-gold); font-weight: 700;\r\n  letter-spacing: 0.14em; text-transform: uppercase;\r\n  animation: bookedLbl 3s ease-in-out infinite;\r\n}\r\n@keyframes bookedLbl {\r\n  0%,38%  { opacity: 0; transform: translateY(5px); }\r\n  60%,82% { opacity: 1; transform: translateY(0); }\r\n  100%    { opacity: 0; }\r\n}\r\n\r\n\u002F* ─────────────────────────────\r\n   SCROLL-TRIGGERED REVEAL\r\n   JS adds .in-view when element\r\n   enters viewport → anim plays\r\n───────────────────────────── *\u002F\r\n@keyframes fadeUp {\r\n  from { opacity: 0; transform: translateY(36px); }\r\n  to   { opacity: 1; transform: translateY(0); }\r\n}\r\n@keyframes fadeFromLeft {\r\n  from { opacity: 0; transform: translateX(-44px); }\r\n  to   { opacity: 1; transform: translateX(0); }\r\n}\r\n@keyframes fadeFromRight {\r\n  from { opacity: 0; transform: translateX(44px); }\r\n  to   { opacity: 1; transform: translateX(0); }\r\n}\r\n@keyframes popIn {\r\n  from { opacity: 0; transform: scale(0.4); }\r\n  to   { opacity: 1; transform: scale(1); }\r\n}\r\n\r\n\u002F* Hidden state — only when JS is active (set via .js-ready on body) *\u002F\r\n.js-ready .tl-hd h2,\r\n.js-ready .tl-hd p,\r\n.js-ready .tl-step .tl-content,\r\n.js-ready .tl-step .tl-ring,\r\n.js-ready .tl-step .tl-anim {\r\n  opacity: 0;\r\n}\r\n\r\n\u002F* Headline reveals *\u002F\r\n.tl-hd.in-view h2 { animation: fadeUp 0.9s cubic-bezier(0.16,1,0.3,1) 0s    both; }\r\n.tl-hd.in-view p  { animation: fadeUp 0.8s cubic-bezier(0.16,1,0.3,1) 0.18s both; }\r\n\r\n\u002F* Step 01 *\u002F\r\n.tl-step:nth-child(1).in-view .tl-content { animation: fadeFromLeft  0.85s cubic-bezier(0.16,1,0.3,1) 0s    both; }\r\n.tl-step:nth-child(1).in-view .tl-ring    { animation: popIn         0.55s cubic-bezier(0.34,1.56,0.64,1) 0.18s both; }\r\n.tl-step:nth-child(1).in-view .tl-anim    { animation: fadeFromRight  0.85s cubic-bezier(0.16,1,0.3,1) 0.22s both; }\r\n\r\n\u002F* Step 02 *\u002F\r\n.tl-step:nth-child(2).in-view .tl-anim    { animation: fadeFromLeft  0.85s cubic-bezier(0.16,1,0.3,1) 0s    both; }\r\n.tl-step:nth-child(2).in-view .tl-ring    { animation: popIn         0.55s cubic-bezier(0.34,1.56,0.64,1) 0.18s both; }\r\n.tl-step:nth-child(2).in-view .tl-content { animation: fadeFromRight  0.85s cubic-bezier(0.16,1,0.3,1) 0.22s both; }\r\n\r\n\u002F* Step 03 *\u002F\r\n.tl-step:nth-child(3).in-view .tl-content { animation: fadeFromLeft  0.85s cubic-bezier(0.16,1,0.3,1) 0s    both; }\r\n.tl-step:nth-child(3).in-view .tl-ring    { animation: popIn         0.55s cubic-bezier(0.34,1.56,0.64,1) 0.18s both; }\r\n.tl-step:nth-child(3).in-view .tl-anim    { animation: fadeFromRight  0.85s cubic-bezier(0.16,1,0.3,1) 0.22s both; }\r\n\u003C\u002Fstyle\u003E\r\n\u003C\u002Fhead\u003E\r\n\u003Cbody\u003E\r\n\r\n\u003Csection class=\"tl-section\"\u003E\r\n  \u003Cdiv class=\"tl-inner\"\u003E\r\n\r\n    \u003C!-- Headline --\u003E\r\n    \u003Cdiv class=\"tl-hd\"\u003E\r\n      \u003Ch2\u003EDarum haken dich Geschäftsführer\u003Cbr\u003Egedanklich schon nach 10 Sekunden ab\u003C\u002Fh2\u003E\r\n      \u003Cp\u003E... und wie du dafür sorgst, dass sie ihr Häkchen stattdessen bei eurem Erstgespräch setzen.\u003C\u002Fp\u003E\r\n    \u003C\u002Fdiv\u003E\r\n\r\n    \u003Cdiv class=\"tl-body\"\u003E\r\n\r\n      \u003C!-- STEP 01 --\u003E\r\n      \u003Cdiv class=\"tl-step\"\u003E\r\n        \u003Cdiv class=\"tl-content\"\u003E\r\n          \u003Ch3\u003E75% der Interessenten entscheiden oben auf deiner Seite\u003C\u002Fh3\u003E\r\n          \u003Cp\u003EUnd diese KMU-Entscheider lehnen dich nicht ab, wenn sie von dir lesen. Sie fühlen nur nichts – und gehen weiter.\r\n\r\nGerade KI-Dienstleister verlieren hier ihre Chancen: Ihr Angebot ist bewährt, aber auf der eigenen Website klingt es wie der Online-Auftritt von der Konkurrenz.\r\n\r\nOnline hast du keinen Verkäufer, der deine potenziellen Kunden begeistert. Du hast nur wenige Sekunden, in denen deine Texte zeigen müssen: \u003Cem\u003E„Ich verstehe dein Geschäft – und bin relevant.\"\u003C\u002Fem\u003E\u003C\u002Fp\u003E\r\n        \u003C\u002Fdiv\u003E\r\n        \u003Cdiv class=\"tl-node\"\u003E\u003Cdiv class=\"tl-ring\"\u003E01\u003C\u002Fdiv\u003E\u003C\u002Fdiv\u003E\r\n        \u003Cdiv class=\"tl-anim\"\u003E\r\n          \u003Cdiv class=\"anim-box ab-timer\"\u003E\r\n            \u003Csvg class=\"ab-timer-svg\" viewBox=\"0 0 100 100\"\u003E\r\n              \u003Ccircle class=\"ab-timer-track\" cx=\"50\" cy=\"50\" r=\"43\"\u003E\u003C\u002Fcircle\u003E\r\n              \u003Ccircle class=\"ab-timer-ring\" cx=\"50\" cy=\"50\" r=\"43\"\u003E\u003C\u002Fcircle\u003E\r\n              \u003Ctext class=\"ab-timer-num\" id=\"tl-timer-num\" x=\"50\" y=\"46\"\u003E10\u003C\u002Ftext\u003E\r\n              \u003Ctext class=\"ab-timer-sub\" x=\"50\" y=\"60\"\u003ESekunden\u003C\u002Ftext\u003E\r\n            \u003C\u002Fsvg\u003E\r\n          \u003C\u002Fdiv\u003E\r\n        \u003C\u002Fdiv\u003E\r\n      \u003C\u002Fdiv\u003E\r\n\r\n      \u003C!-- STEP 02 --\u003E\r\n      \u003Cdiv class=\"tl-step\"\u003E\r\n        \u003Cdiv class=\"tl-anim\"\u003E\r\n          \u003Cdiv class=\"anim-box\"\u003E\r\n            \u003Cdiv class=\"ab-bar\"\u003E\r\n              \u003Cspan class=\"ab-dot\"\u003E\u003C\u002Fspan\u003E\u003Cspan class=\"ab-dot\"\u003E\u003C\u002Fspan\u003E\u003Cspan class=\"ab-dot\"\u003E\u003C\u002Fspan\u003E\r\n              \u003Cspan class=\"ab-url\"\u003E\u003C\u002Fspan\u003E\r\n            \u003C\u002Fdiv\u003E\r\n            \u003Cdiv class=\"ab-lines\"\u003E\r\n              \u003Cdiv class=\"ab-line\"\u003E\u003C\u002Fdiv\u003E\u003Cdiv class=\"ab-line\"\u003E\u003C\u002Fdiv\u003E\u003Cdiv class=\"ab-line\"\u003E\u003C\u002Fdiv\u003E\r\n              \u003Cdiv class=\"ab-line\"\u003E\u003C\u002Fdiv\u003E\u003Cdiv class=\"ab-line\"\u003E\u003C\u002Fdiv\u003E\r\n            \u003C\u002Fdiv\u003E\r\n            \u003Cdiv class=\"ab-cursor\"\u003E\u003C\u002Fdiv\u003E\r\n          \u003C\u002Fdiv\u003E\r\n        \u003C\u002Fdiv\u003E\r\n        \u003Cdiv class=\"tl-node\"\u003E\u003Cdiv class=\"tl-ring\"\u003E02\u003C\u002Fdiv\u003E\u003C\u002Fdiv\u003E\r\n        \u003Cdiv class=\"tl-content\"\u003E\r\n          \u003Ch3\u003EWas stattdessen bei KI-Beratern passiert\u003C\u002Fh3\u003E\r\n          \u003Cp\u003ETexte und Aufbau wurden schnell erstellt oder nie hinterfragt. ChatGPT, Claude oder Agenturen liefern korrekten, glatten Durchschnitt.\r\n\r\nUnd dann wunderst du dich, dass die echte DNA deines Unternehmens im Wettbewerbsnebel verschwindet.\r\n\r\nWie vermiedest du also generischen AI Slop, der deine Lead-Conversions einbrechen lässt?\u003C\u002Fp\u003E\r\n        \u003C\u002Fdiv\u003E\r\n      \u003C\u002Fdiv\u003E\r\n\r\n      \u003C!-- STEP 03 --\u003E\r\n      \u003Cdiv class=\"tl-step\"\u003E\r\n        \u003Cdiv class=\"tl-content\"\u003E\r\n          \u003Ch3\u003EMit diesem roten Faden konvertierst du Traffic in Leads — ohne dein Zutun\u003C\u002Fh3\u003E\r\n          \u003Cp\u003ESchwache Außenkommunikation kosten dich neben Klicks vor allem qualifizierte Anfragen, bevor sie entstehen.\r\n\r\nIch übersetze die DNA deiner KI-Agentur in eine No-Brainer-Message, die bei KMU-Entscheidern in Kopf, Herz und Bauch bleiben.\r\n\r\nSo werden aus skeptischen Besuchern Gesprächspartner, die Geld bei euch lassen.\r\n\r\n\u003Cstrong\u003EViel Geld. Und diesen roten Faden entwerfe ich für dich.\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E\r\n        \u003C\u002Fdiv\u003E\r\n        \u003Cdiv class=\"tl-node\"\u003E\u003Cdiv class=\"tl-ring\"\u003E03\u003C\u002Fdiv\u003E\u003C\u002Fdiv\u003E\r\n        \u003Cdiv class=\"tl-anim\"\u003E\r\n          \u003Cdiv class=\"anim-box ab-booked\"\u003E\r\n            \u003Cdiv class=\"ab-cal\"\u003E\r\n              \u003Cdiv class=\"ab-cal-hd\"\u003E\u003Cspan class=\"ab-cal-ttl\"\u003EKalender\u003C\u002Fspan\u003E\u003C\u002Fdiv\u003E\r\n              \u003Cdiv class=\"ab-slots\"\u003E\r\n                \u003Cdiv class=\"ab-slot\"\u003E\u003C\u002Fdiv\u003E\u003Cdiv class=\"ab-slot\"\u003E\u003C\u002Fdiv\u003E\r\n                \u003Cdiv class=\"ab-slot\"\u003E\u003C\u002Fdiv\u003E\u003Cdiv class=\"ab-slot\"\u003E\u003C\u002Fdiv\u003E\r\n                \u003Cdiv class=\"ab-slot\"\u003E\u003C\u002Fdiv\u003E\u003Cdiv class=\"ab-slot ab-slot-active\"\u003E\u003C\u002Fdiv\u003E\r\n                \u003Cdiv class=\"ab-slot\"\u003E\u003C\u002Fdiv\u003E\u003Cdiv class=\"ab-slot\"\u003E\u003C\u002Fdiv\u003E\r\n              \u003C\u002Fdiv\u003E\r\n              \u003Cdiv class=\"ab-check-circle\"\u003E\r\n                \u003Csvg class=\"ab-check-svg\" viewBox=\"0 0 20 20\"\u003E\r\n                  \u003Cpath class=\"ab-check-path\" d=\"M4 10l4 4 8-8\"\u003E\u003C\u002Fpath\u003E\r\n                \u003C\u002Fsvg\u003E\r\n              \u003C\u002Fdiv\u003E\r\n            \u003C\u002Fdiv\u003E\r\n            \u003Cspan class=\"ab-booked-lbl\"\u003ETermin gebucht ✓\u003C\u002Fspan\u003E\r\n          \u003C\u002Fdiv\u003E\r\n        \u003C\u002Fdiv\u003E\r\n      \u003C\u002Fdiv\u003E\r\n\r\n    \u003C\u002Fdiv\u003E\u003C!-- \u002Ftl-body --\u003E\r\n  \u003C\u002Fdiv\u003E\u003C!-- \u002Ftl-inner --\u003E\r\n\u003C\u002Fsection\u003E\r\n\r\n\u003Cscript\u003E\r\n(function(){\r\n\r\n  \u002F* ── Timer countdown ── *\u002F\r\n  var timer = document.getElementById('tl-timer-num');\r\n  if(timer){\r\n    var count = 10;\r\n    setInterval(function(){\r\n      count = count \u003C= 0 ? 10 : count - 1;\r\n      timer.textContent = count;\r\n    }, 300);\r\n  }\r\n\r\n  \u002F* ── Scroll-triggered reveal ── *\u002F\r\n  \u002F\u002F Mark body so CSS hides elements (graceful degradation: no JS = always visible)\r\n  document.body.classList.add('js-ready');\r\n\r\n  var hd    = document.querySelector('.tl-hd');\r\n  var steps = document.querySelectorAll('.tl-step');\r\n\r\n  function observe(el, delay){\r\n    if(!el) return;\r\n    var obs = new IntersectionObserver(function(entries){\r\n      entries.forEach(function(e){\r\n        if(e.isIntersecting){\r\n          setTimeout(function(){ el.classList.add('in-view'); }, delay || 0);\r\n          obs.unobserve(el);\r\n        }\r\n      });\r\n    }, { threshold: 0.18 });\r\n    obs.observe(el);\r\n  }\r\n\r\n  \u002F\u002F Headline\r\n  observe(hd, 0);\r\n\r\n  \u002F\u002F Each step triggers individually as user scrolls — stagger 0ms (each has own delay in CSS)\r\n  steps.forEach(function(step){ observe(step, 0); });\r\n\r\n})();\r\n\u003C\u002Fscript\u003E\r\n\u003C\u002Fbody\u003E\r\n\u003C\u002Fhtml\u003E","css":"","js":"","scss":""},"styles":{"indentLg":37}}]}]}]}]}},{"_id":"_oOm16ar6iuBiHgYCgIGc","data":{},"title":"Solution","position":9,"layout":"l21a","type":"default","molecules":[{"_id":"adb7c278-1b7c-40a7-bba0-af629adf9c5d","position":1,"styles":{"align_top":"top","style_type":"transparent","orientation":"vertical","style_color":"inherit","align_center":"left","layout_column":22,"style_color_type":"auto","style_color_custom":"","style_color_variation":"harmonic","align_horizontal":"center"},"data":{},"type":"base","moleculeModel":"text-block","children":[],"atoms":[{"_id":"d3c58147-d220-4032-9356-c7315d01fd7e","position":1,"type":"header","data":{"items":[{"data":{"type":"facebook","link_text":"Facebook","link_href":"","link_blank":false},"styles":{},"_id":"2cff9088-59f5-4a8c-9e6a-51d82ea1ee73"},{"data":{"type":"instagram","link_text":"Instagram","link_href":"","link_blank":false},"styles":{},"_id":"c038205e-1cd6-4d3e-b0bd-0cd1598374a3"},{"data":{"type":"youtube","link_text":"Youtube","link_href":"","link_blank":false},"styles":{},"_id":"7660cc7e-e8c3-4ebc-9620-443dcaad7686"}],"text":{"blocks":[{"key":