it-atom-menu-v2-item-inside__wrapp"><div class="con-kit-atom-menu-v2-item-inside__decorator"></div><div class="con-kit-atom-menu-v2-item-inside__text"><div class="con-kit-atom-menu-v2-item-inside__title" style="--font-kit-family:var(--font-kit-header-font);--font-kit-weight:600;--font-kit-line-height:var(--font-kit-header-line-height);--font-kit-letter-spacing:var(--font-kit-header-letter-spacing);--font-kit-text-transform:var(--font-kit-header-transform)">Dienstleistungen</div></div></div></button></li><li data-id="0mqt8BHPzMsbNRQruECix" class="con-kit-atom-menu-v2-item con-kit-atom-menu-v2-item--collapsed" data-mega-place="item"><button class="con-kit-link-button con-kit-atom-menu-v2-item-inside con-kit-atom-menu-v2-item-inside--collapsed" draggable="false" type="button"><div class="con-kit-atom-menu-v2-item-inside__wrapp"><div class="con-kit-atom-menu-v2-item-inside__decorator"></div><div class="con-kit-atom-menu-v2-item-inside__text"><div class="con-kit-atom-menu-v2-item-inside__title" style="--font-kit-family:var(--font-kit-header-font);--font-kit-weight:600;--font-kit-line-height:var(--font-kit-header-line-height);--font-kit-letter-spacing:var(--font-kit-header-letter-spacing);--font-kit-text-transform:var(--font-kit-header-transform)">Zum kostenlosen Erstgespräch</div></div></div></button></li></ul></div></li></ul></nav><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div><div data-atom="custom-code" data-id="1c2d7264-7b47-4129-81dc-cd94fe4cdccd" data-position="3" data-mode="horizontal" data-atom-horizontal="center" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:20px;--a-width:47.246995681371445%;--one-kit-animation-item-delay:3s"><div style="width:100%;position:relative">
            <!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&display=swap">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

.lc-nav-cta-wrap {
  /* Positionierung: oben rechts in deiner Nav */
  display: inline-flex;
  align-items: center;
}

.lc-nav-cta {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  background: #C9A84C;
  color: #ffffff;
  font-family: 'Montserrat', sans-serif;
  font-weight: 700;
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  text-decoration: none;
  border: none;
  cursor: pointer;
  padding: 12px 28px;
  border-radius: 10px;
  box-shadow: 0 4px 20px rgba(201,168,76,0.45);
  line-height: 1.2;
  will-change: transform;
  transition: background 0.2s, box-shadow 0.3s;
}
.lc-nav-cta:hover {
  background: #E8C96A;
  box-shadow: 0 8px 32px rgba(201,168,76,0.55);
}
.lc-nav-cta-sub {
  font-size: 9px;
  font-weight: 500;
  letter-spacing: 0.06em;
  color: rgba(255,255,255,0.6);
  text-transform: none;
}

/* Glanzschweif */
.lc-nav-cta {
  overflow: hidden;
  position: relative;
}
.lc-nav-cta::after {
  content: '';
  position: absolute;
  top: 0; left: -75%;
  width: 50%; height: 100%;
  background: linear-gradient(
    120deg,
    transparent 0%,
    rgba(255,255,255,0.55) 50%,
    transparent 100%
  );
  transform: skewX(-20deg);
  animation: navShine 2.5s ease-in-out infinite;
  pointer-events: none;
}
@keyframes navShine {
  0%   { left: -75%; opacity: 0; }
  8%   { opacity: 1; }
  38%  { left: 130%; opacity: 0; }
  100% { left: 130%; opacity: 0; }
}
</style>
</head>
<body>


<div class="lc-nav-cta-wrap">
  <a href="#formular" id="nav-cta" class="lc-nav-cta">
    Potenzialanalyse buchen
    <span class="lc-nav-cta-sub">100% kostenlos &amp; unverbindlich</span>
  </a>
</div>


<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script>
(function(){
  var cta = document.getElementById('nav-cta');
  if(!cta) return;

  // ── Magnetischer Hover ──
  cta.addEventListener('mousemove', function(e){
    var r = cta.getBoundingClientRect();
    var x = (e.clientX - r.left - r.width  / 2) * 0.35;
    var y = (e.clientY - r.top  - r.height / 2) * 0.35;
    gsap.to(cta, { x:x, y:y, duration:0.35, ease:'power2.out' });
  });
  cta.addEventListener('mouseleave', function(){
    gsap.to(cta, { x:0, y:0, duration:0.7, ease:'elastic.out(1, 0.45)' });
  });

  // ── Scroll zu onepage.io Abschnitt "formular" ──
  cta.addEventListener('click', function(e){
    e.preventDefault();
    var anchor = 'formular';

    // OPTION A: Element mit id="formular"
    var ziel = document.getElementById(anchor);
    if(ziel){ ziel.scrollIntoView({ behavior:'smooth', block:'start' }); return; }

    // OPTION B: onepage.io data-anchor Attribut
    var sectionEl = document.querySelector('[data-anchor="' + anchor + '"]');
    if(sectionEl){ sectionEl.scrollIntoView({ behavior:'smooth', block:'start' }); return; }

    // OPTION C: Nächster Abschnitt als Fallback
    var nav = cta.closest('nav') || cta.closest('header');
    if(nav && nav.nextElementSibling){
      nav.nextElementSibling.scrollIntoView({ behavior:'smooth', block:'start' });
    }
  });
})();
</script>

</body>
</html>
