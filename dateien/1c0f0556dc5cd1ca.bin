3.195" fill="none" data-stroke="#000" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M8.798,10.387c.127,.067,.276,.067,.403,0,.673-.354,2.798-1.636,2.798-3.721,.003-.916-.73-1.661-1.64-1.667-.547,.007-1.056,.285-1.36,.743-.304-.458-.813-.736-1.36-.743-.91,.006-1.643,.751-1.64,1.667,0,2.085,2.125,3.367,2.798,3.721Z" data-fill="#000" data-color="color-2" data-stroke="none"></path></svg></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div><div data-atom="header" data-id="6807ed0a-e7bb-450a-924a-a214b1e870ad" data-position="2" data-mode="vertical" data-atom-horizontal="left" data-atom-vertical="top" data-atom-zero-indenet="" class="con-kit-animation__atom" style="--a-indent-lg:0px;--a-width:100%;--one-kit-animation-item-delay:2s"><div class="con-kit-atom-header" style="--color-text:10,10,10;--alpha-text:1;--color-bg:255,255,255;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;white&quot;,&quot;colorBgType&quot;:&quot;palette&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,255,255],&quot;colorBgVariant&quot;:&quot;__root&quot;,&quot;colorText&quot;:&quot;dark&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[10,10,10],&quot;colorTextVariant&quot;:&quot;text&quot;}"></div><div class="con-kit-component-header" data-text-prop="text" data-font-kit-type="s"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="s" data-block-key="8m1sv">Artus, der Empath</div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="s" data-block-key="h0cd"><br/></div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div><div data-atom="plain-text" data-id="1753a96c-2cd0-420a-9629-d7a0054841f0" data-position="3" data-mode="vertical" data-atom-horizontal="left" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:20px;--a-width:95.5344255978045%;--one-kit-animation-item-delay:3s"><div class="con-kit-atom-plain-text" data-font-kit-type="l" style="--color-text:10,10,10;--alpha-text:0.51;--color-bg:255,255,255;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;white&quot;,&quot;colorBgType&quot;:&quot;palette&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,255,255],&quot;colorBgVariant&quot;:&quot;__root&quot;,&quot;colorText&quot;:&quot;dark&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:0.51,&quot;colorTextFormat&quot;:[10,10,10],&quot;colorTextVariant&quot;:&quot;text&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="l"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="l" data-block-key="8r4b3">Als Conversion-Architekt beginnt meine Arbeit damit dich, dein Angebot und deine Zielgruppe wirklich zu verstehen. </div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="l" data-block-key="f8sma">Ich versetze mich in ihre Lage, um sie klar und überzeugend ansprechen zu können.</div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="l" data-block-key="6vf08">Das gelingt mir besonders leicht, weil ich verschiedenste Kundentypen aus vielen Branchen analysiert habe.</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-slider-v2-item embla__slide  con-kit-animation__grid_item" style="--bento-x:1;--one-kit-animation-item-delay:1s"><div style="--color-text:10,10,10;--alpha-text:1;--color-bg:255,255,255;--alpha-bg:1;--color-border:201,168,76;--alpha-border:1;--bento-x:1;--bento-y:1;--one-kit-radius:16px;--one-kit-padding:32px" class="con-kit-molecule-textBlock" data-molecule="text-block" data-id="c48ebe8b-3a74-4fc9-af7f-0fbb33f1e642" data-kit-radius="16" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="line"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="icon" data-id="a0609db7-c579-4712-b8ee-39ab1df5ca9f" data-position="1" data-mode="vertical" data-atom-horizontal="left" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:30px;--a-width:100%;--one-kit-animation-item-delay:1s"><div aria-hidden="true" class="con-kit-component-icon con-kit-component-icon--style-transparent con-kit-component-icon--size-m" data-icon-info="a-check outline" style="--component-icon__line-weight:1.2257142857142855px;--component-icon__svg-size:24;--component-icon__size:56px;--color-text:201,168,76;--alpha-text:1;--color-bg:255,255,255;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--color-secondary-text:201,168,76;--alpha-secondary-text:1"><span class="con-kit-component-icon__border" data-kit-radius="custom" style="--one-kit-radius:13px"></span><svg viewBox="0 0 24 24" preserveAspectRatio="none"><path data-cap="butt" fill="none" data-stroke="#444444" stroke-width="2" stroke-miterlimit="10" d="M11,13 c-2.824,0-5.329,0.638-6.975,1.193C2.81,14.604,2,15.749,2,17.032V21h8" stroke-linejoin="miter" stroke-linecap="butt"></path> <path fill="none" data-stroke="#444444" stroke-width="2" stroke-linecap="square" stroke-miterlimit="10" d="M11,13L11,13 c-2.761,0-5-3.239-5-6V6c0-2.761,2.239-5,5-5h0c2.761,0,5,2.239,5,5v1C16,9.761,13.761,13,11,13z" stroke-linejoin="miter"></path> <polyline data-color="color-2" fill="none" data-stroke="#444444" stroke-width="2" stroke-linecap="square" stroke-miterlimit="10" points=" 15,20 17,22 22,17 " stroke-linejoin="miter"></polyline></svg></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div><div data-atom="header" data-id="866cf401-3e5b-4d19-96e1-84b4650c8978" data-position="2" data-mode="vertical" data-atom-horizontal="left" data-atom-vertical="top" data-atom-zero-indenet="" class="con-kit-animation__atom" style="--a-indent-lg:0px;--a-width:100%;--one-kit-animation-item-delay:2s"><div class="con-kit-atom-header" style="--color-text:10,10,10;--alpha-text:1;--color-bg:255,255,255;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;white&quot;,&quot;colorBgType&quot;:&quot;palette&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,255,255],&quot;colorBgVariant&quot;:&quot;__root&quot;,&quot;colorText&quot;:&quot;dark&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[10,10,10],&quot;colorTextVariant&quot;:&quot;text&quot;}"></div><div class="con-kit-component-header" data-text-prop="text" data-font-kit-type="s"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="s" data-block-key="8m1sv">Richard, Professionell</div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="s" data-block-key="brckt"><br/></div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div><div data-atom="plain-text" data-id="eb88a9b1-4a5d-4ae1-9d56-8f1026a2054e" data-position="3" data-mode="vertical" data-atom-horizontal="left" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:20px;--a-width:100%;--one-kit-animation-item-delay:3s"><div class="con-kit-atom-plain-text" data-font-kit-type="l" style="--color-text:10,10,10;--alpha-text:0.5;--color-bg:255,255,255;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;white&quot;,&quot;colorBgType&quot;:&quot;palette&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,255,255],&quot;colorBgVariant&quot;:&quot;__root&quot;,&quot;colorText&quot;:&quot;dark&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:0.5,&quot;colorTextFormat&quot;:[10,10,10],&quot;colorTextVariant&quot;:&quot;text&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="l"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="l" data-block-key="8r4b3">Meine Faszination für die Verhaltenspsychologie hinter unseren Entscheidungen ist grenzenlos. </div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="l" data-block-key="2esp7">Nach meiner Marketing-Ausbildung bei Deutschlands Copywriting Marktführer war mir klar: Ich möchte Unternehmen, die es ernst mit ihrem Business meinen zu mehr Kunden verhelfen.</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-slider-v2-item embla__slide  con-kit-animation__grid_item" style="--bento-x:1;--one-kit-animation-item-delay:2s"><div style="--color-text:10,10,10;--alpha-text:1;--color-bg:255,255,255;--alpha-bg:1;--color-border:201,168,76;--alpha-border:1;--bento-x:1;--bento-y:1;--one-kit-radius:16px;--one-kit-padding:32px" class="con-kit-molecule-textBlock" data-molecule="text-block" data-id="6c28068b-fdfd-45dd-9068-cb6667d7061a" data-kit-radius="16" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="line"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="icon" data-id="89f3dca5-a004-4a18-984a-68396b6248b1" data-position="1" data-mode="vertical" data-atom-horizontal="left" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:30px;--a-width:100%;--one-kit-animation-item-delay:1s"><div aria-hidden="true" class="con-kit-component-icon con-kit-component-icon--style-transparent con-kit-component-icon--size-m" data-icon-info="bulb-63 outline" style="--component-icon__line-weight:1.2257142857142855px;--component-icon__svg-size:24;--component-icon__size:56px;--color-text:201,168,76;--alpha-text:1;--color-bg:255,255,255;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--color-secondary-text:201,168,76;--alpha-secondary-text:1"><span class="con-kit-component-icon__border" data-kit-radius="custom" style="--one-kit-radius:13px"></span><svg viewBox="0 0 24 24" preserveAspectRatio="none"><line data-color="color-2" fill="none" data-stroke="#444444" stroke-width="2" stroke-linecap="square" stroke-miterlimit="10" x1="1" y1="12" x2="3" y2="12" stroke-linejoin="miter"></line> <line data-color="color-2" fill="none" data-stroke="#444444" stroke-width="2" stroke-linecap="square" stroke-miterlimit="10" x1="4.222" y1="4.222" x2="5.636" y2="5.636" stroke-linejoin="miter"></line> <line data-color="color-2" fill="none" data-stroke="#444444" stroke-width="2" stroke-linecap="square" stroke-miterlimit="10" x1="12" y1="1" x2="12" y2="3" stroke-linejoin="miter"></line> <line data-color="color-2" fill="none" data-stroke="#444444" stroke-width="2" stroke-linecap="square" stroke-miterlimit="10" x1="19.778" y1="4.222" x2="18.364" y2="5.636" stroke-linejoin="miter"></line> <line data-color="color-2" fill="none" data-stroke="#444444" stroke-width="2" stroke-linecap="square" stroke-miterlimit="10" x1="23" y1="12" x2="21" y2="12" stroke-linejoin="miter"></line> <path fill="none" data-stroke="#444444" stroke-width="2" stroke-