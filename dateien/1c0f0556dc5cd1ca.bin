"border_width":"default","border_width_custom":1,"border_type":"solid","radius_key":"4","radius_custom":4,"align_horizontal":"left","align_vertical":"middle","padding_key":"xl","padding_custom":48,"shadow_key":"none","shadow_x":0,"shadow_y":8,"shadow_blur":40,"shadow_spreed":0,"shadow_opacity":0.15,"position":2,"bg_image_position":[50,50]},"data":{},"type":"base","moleculeModel":"text-block","children":[],"atoms":[{"_id":"83a107ac-5d8e-4b84-b46b-9939be30f890","type":"image","position":1,"data":{"src":"media\u002Fb6571586-6267-4716-a370-7abcc2aaf01b","name":"artnoiser_copywriter_working_on_his_laptop_frontal_photo_4ddd80d9-db99-4eb8-80e6-f9593c17e37a.png"},"styles":{"resize_percent":87,"media_type":"fill","radius_key":"8","indentLg":0}}]}],"position":2,"type":"default","layer":{"_id":"ELRzpT1wIkwRVPpGwvy5h","type":"flex","data":{},"styles":{},"frames":[{"_id":"ow32vezE77xvQiUOTBvsv","position":1,"data":{},"styles":{},"type":"default","rows":[{"_id":"jPmvLuLDXZDY9OjXbeW2s","position":1,"data":{},"styles":{"align_horizontal":"right","grid_type":"columns"},"molecules":[{"_id":"UU7H-dr7JIFTUIhWGHEth","position":1,"styles":{"layout_column":24,"style_type":"transparent","color_text":"inherit","color_text_type":"auto","color_text_alpha":1,"color_text_variation":"text","color_text_custom":"","color_bg":"inherit","color_bg_type":"auto","color_bg_alpha":1,"color_bg_variation":"harmonic","color_bg_custom":"","color_border":"inherit","color_border_type":"auto","color_border_alpha":1,"color_border_variation":"harmonic","color_border_custom":"","bg_image_src":"","bg_image_arrangement":"centerCenter","overlay_type":"none","overlay_gradient_direction":"vertical","overlay_gradient_color1":"key1","overlay_gradient_opacity1":10,"overlay_gradient_color2":"dark","overlay_gradient_opacity2":30,"overlay_solid_color":"black","overlay_solid_opacity":30,"border_width":"default","border_width_custom":1,"border_type":"solid","radius_key":"4","radius_custom":4,"align_horizontal":"left","align_vertical":"middle","padding_key":"xl","padding_custom":48,"shadow_key":"none","shadow_x":0,"shadow_y":8,"shadow_blur":40,"shadow_spreed":0,"shadow_opacity":0.15,"position":2,"bg_image_position":[50,50],"__temporary_wrap_header_atoms":false},"data":{},"type":"base","moleculeModel":"text-block","children":[],"atoms":[{"_id":"3f1e0eea-3872-4351-8f7d-06d9deb3fb6a","type":"custom-code","position":1,"data":{"html":"\u003C!DOCTYPE html\u003E\r\n\u003Chtml lang=\"de\"\u003E\r\n\u003Chead\u003E\r\n\u003Cmeta charset=\"UTF-8\"\u003E\r\n\u003Cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"\u003E\r\n\u003Clink rel=\"preconnect\" href=\"https:\u002F\u002Ffonts.googleapis.com\"\u003E\r\n\u003Clink rel=\"stylesheet\" href=\"https:\u002F\u002Ffonts.googleapis.com\u002Fcss2?family=Cormorant+Garamond:wght@400;600&family=Montserrat:wght@600;700;800&family=DM+Sans:wght@400;500;600&display=swap\"\u003E\r\n\u003Cstyle\u003E\r\n*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\r\n:root {\r\n  --c-void:        #0A0A0A;\r\n  --c-gold:        #C9A84C;\r\n  --c-gold-border: rgba(201,168,76,0.30);\r\n  --c-headline:    #F5F0E8;\r\n  --c-body:        #A8A9AD;\r\n  --c-body-soft:   #7A7B7F;\r\n  --c-divider:     rgba(168,169,173,0.18);\r\n  --f-display:     'Cormorant Garamond', Georgia, serif;\r\n  --f-headline:    'Montserrat', sans-serif;\r\n  --f-body:        'DM Sans', sans-serif;\r\n  --radius-full:   9999px;\r\n}\r\nbody { background: var(--c-void); color: var(--c-body); font-family: var(--f-body); }\r\n.wrap { max-width: 1280px; margin: 0 auto; padding: 0 56px; }\r\n.hero {\r\n  min-height: 100vh; position: relative;\r\n  display: flex; align-items: center;\r\n  padding: 80px 0; overflow: hidden;\r\n  background: var(--c-void);\r\n}\r\n.hero-bg { position: absolute; inset: 0; pointer-events: none; }\r\n.hero-radial {\r\n  position: absolute; inset: 0;\r\n  background:\r\n    radial-gradient(ellipse 50% 65% at var(--mx, 75%) var(--my, 40%), rgba(28,68,140,0.7) 0%, transparent 60%),\r\n    radial-gradient(ellipse 30% 40% at var(--mx2, 85%) var(--my2, 55%), rgba(201,168,76,0.08) 0%, transparent 50%);\r\n  will-change: background;\r\n}\r\n.hero-layout {\r\n  display: grid; grid-template-columns: 42% 1fr;\r\n  align-items: center; gap: 56px;\r\n  width: 100%; position: relative; z-index: 2;\r\n}\r\n.hero-photo-box {\r\n  width: 100%; aspect-ratio: 3\u002F4; border-radius: 18px; overflow: hidden;\r\n  background: rgba(15,15,22,0.7); border: 1px solid var(--c-divider);\r\n}\r\n.hero-photo-box img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }\r\n.hero-badge {\r\n  display: inline-flex; align-items: center; gap: 10px;\r\n  background: rgba(201,168,76,0.08); border: 1px solid var(--c-gold-border);\r\n  border-radius: var(--radius-full); padding: 8px 20px; margin-bottom: 36px;\r\n}\r\n.hero-badge-dot {\r\n  width: 7px; height: 7px; border-radius: 50%; background: var(--c-gold);\r\n  animation: dotPulse 2s ease-in-out infinite;\r\n}\r\n@keyframes dotPulse {\r\n  0%,100% { opacity:1; transform:scale(1); box-shadow:0 0 0 0 rgba(201,168,76,0.4); }\r\n  50%      { opacity:0.7; transform:scale(0.8); box-shadow:0 0 0 4px rgba(201,168,76,0); }\r\n}\r\n.hero-badge-text { font-size: 13px; font-weight: 500; color: var(--c-gold); letter-spacing: 0.03em; }\r\n.hero-headline {\r\n  font-family: var(--f-display); font-size: clamp(2.4rem, 4vw, 3.8rem);\r\n  font-weight: 600; color: var(--c-headline);\r\n  line-height: 1.1; margin-bottom: 28px; letter-spacing: -0.01em;\r\n}\r\n.hero-headline .gold { color: var(--c-gold); }\r\n.hero-sub {\r\n  font-size: 1.1rem; color: var(--c-body);\r\n  line-height: 1.65; max-width: 560px; margin-bottom: 44px;\r\n}\r\n.hero-sub strong { color: var(--c-headline); font-weight: 600; }\r\n.btn-primary {\r\n  display: inline-flex; align-items: center;\r\n  background: var(--c-gold); color: #0A0A0A;\r\n  font-family: var(--f-headline); font-weight: 700;\r\n  font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;\r\n  text-decoration: none; border: none; cursor: pointer;\r\n  padding: 16px 36px; border-radius: 10px;\r\n  box-shadow: 0 4px 20px rgba(201,168,76,0.45);\r\n  transition: background 0.2s, box-shadow 0.3s, transform 0.2s;\r\n}\r\n.btn-primary:hover { background: #E8C96A; box-shadow: 0 8px 32px rgba(201,168,76,0.55); }\r\n.btn-primary { transform-style: preserve-3d; will-change: transform; }\r\n\u003C\u002Fstyle\u003E\r\n\u003C\u002Fhead\u003E\r\n\u003Cbody\u003E\r\n\u003Csection class=\"hero\"\u003E\r\n  \u003Cdiv class=\"hero-bg\"\u003E\u003Cdiv class=\"hero-radial\"\u003E\u003C\u002Fdiv\u003E\u003C\u002Fdiv\u003E\r\n  \u003Cdiv class=\"wrap\"\u003E\r\n    \u003Cdiv class=\"hero-layout\"\u003E\r\n      \u003Cdiv\u003E\r\n        \u003Cdiv class=\"hero-photo-box\"\u003E\r\n          \u003Cimg src=\"data:image\u002Fpng;base64,\u002FPrGJg3UAAABOZVhJZk1NACoAAAAIAAQBGgAFAAAAAQAAAD4BGwAFAAAAAQAAAEYBKAADAAAAAQACAAACEwADAAAAAQABAAAAAAAAAAAAYAAAAAEAAABgAAAAAXcF3+cACBlNSURBVHic7J1rurQqDoVJ9R5Fz6Pn0fMfS59K\u002F1ARFRZUFARd73Oe7+wqi4tcEy6J\u002FPs\u002F\u002F3UJVJymnlkRcc5J8ulXnXMimx\u002FsPsZQJ+mc6if5RFSvfkWRD3hBGNAS6kzA6xEnn3Rpu3RZi5N0DX7SNQjeXZ1ouiJUjfUOS9u\u002FoixtoG7VnKz6aEcDJQOSE4e64BeVmdQupXI66kp1UC1pvRE+6X5dA3WoUaDBfpQKBGMTDgeKxTlxkS6cHevMhSYytQoNGs9nyYs6900F\u002FH6n4JHxZ6rcJTpxzjn9qJve4SvpOFE+L5djcqBqMmdGLO+uqr4B+BlxzcNnl9HlgahTNFygIR3N88ZpAs3lENT40XCv6v53DD59FPcRIFqASNMJfpYXVNXPkuacuswBo5n5wOYEXh\u002FWIIoS1G+J8BD+ZilP96\u002F0wNV+SIc99Pp5UPWbKlJ1YhRUBYrb0xgbK+0\u002FU2qEEEKGA80ThPzEJLBtFcJ5Rcy8tDLLf7tGOonLo2j7D2CYlZUH8pWMmkdIJZ6hEFbYyiRpqmyk2GYgsJXAGY2QLfiABiEX4Zf+kz\u002FIRCCxnygb78+Ek\u002FV8GEOd\u002Fw5Vw9tlKn\u002FG51gQbIXkmTxDIXTsos2oow06Z4pW18OZhJAsWMpjV2pFVM4cj+OG8zVK2y7Sh5RWJ7A0i\u002FBb1T+0Z\u002FvG6rZSVG4453w\u002FQSG88O174DEKIXkjPNhCyA9MGwSpZ5yEG1Llmllblkso4ZHRRaazLhzGj4wG4jmpSeJKIQmpMFLOG+q6\u002FejeUgNTr9et9v2OV++LpqYCCElAxY6QW+H0S66jxoDOFkpaIYc\u002FViq2Q1nXiSajTDUsOw7BO9\u002F6dprvEFa5BoDPDV