    });
})();       
</script></section><!--/$--><!--$--><section class="con-kit-organism con-kit-section headline con-kit-section--type-default" data-id="67d-5iKylgvsog18P0zz7" data-kit-organism-padding="s" data-p="2" data-position="default" id="main-content" style="--one-kit-width:auto%;--one-kit-width-divider:1" tabindex="-1"><div class="con-kit-layer con-kit-layer-flex" data-layer-type="flex" style="--one-kit-outside-padding:32px"><div class="con-kit-organism-background1" data-organism-bg-id="67d-5iKylgvsog18P0zz7" style="--section-padding-top:0px;--section-padding-bottom:0px;z-index:34;--color-bg:10,10,10;--alpha-bg:1;--color-text:255,255,255;--alpha-text:1;--color-border:10,10,10;--alpha-border:0.1"><div class="con-kit-frame" data-frame-id="ow32vezE77xvQiUOTBvsv"><div class="con-kit-container con-kit-container--style-transparent" data-kit-align-horizontal="center" data-kit-align-vertical="middle" data-kit-container-radius="4" data-kit-frame="transparent" style="--color-text:255,255,255;--alpha-text:1;--color-bg:10,10,10;--alpha-bg:1;--color-border:10,10,10;--alpha-border:1;--one-kit-container-radius:4px;--one-kit-container-padding:0px"><div class="con-kit-rows"><div class="con-kit-row con-kit-row--style-transparent" data-row-id="jPmvLuLDXZDY9OjXbeW2s" data-kit-align-horizontal="right" data-kit-align-vertical="top" style="--row-position:1;--rows-count:1;--a-indent-lg:var(--one-kit-organism-padding)"><div class="con-kit-row__container" data-kit-frame="transparent" data-kit-row-radius="4" style="--color-text:255,255,255;--alpha-text:1;--color-bg:10,10,10;--alpha-bg:1;--color-border:10,10,10;--alpha-border:1;--row-columns:1;--slider-length:1;--one-kit-row-radius:4px"><div class="con-kit-layout" data-cols-lg="24" data-cols-md="24" data-cols-sm="24" data-kit-align-horizontal="right" data-kit-align-vertical="top" data-kit-grid-type="columns" style="--row-columns:1;--one-kit-grid-columns:3"><div class="con-kit-col con-kit-col--last con-kit-col--first" data-col-lg="24" data-col-md="24" data-col-sm="24"><div style="--color-text:255,255,255;--alpha-text:1;--color-bg:10,10,10;--alpha-bg:1;--color-border:10,10,10;--alpha-border:1;--bento-x:1;--bento-y:1;--one-kit-radius:4px;--one-kit-padding:0px" class="con-kit-molecule-textBlock" data-molecule="text-block" data-id="UU7H-dr7JIFTUIhWGHEth" data-kit-radius="4" data-kit-align-horizontal="left" data-kit-align-vertical="middle" data-kit-frame="transparent"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="custom-code" data-id="3f1e0eea-3872-4351-8f7d-06d9deb3fb6a" data-position="1" data-mode="vertical" data-atom-horizontal="left" data-atom-vertical="middle" class="con-kit-animation__atom" style="--a-indent-lg:20px;--a-width:100%;--one-kit-animation-item-delay:1s"><div style="width:100%;position:relative">
            <!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600&family=Montserrat:wght@600;700;800&family=DM+Sans:wght@400;500;600&display=swap">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --c-void:        #0A0A0A;
  --c-gold:        #C9A84C;
  --c-gold-border: rgba(201,168,76,0.30);
  --c-headline:    #F5F0E8;
  --c-body:        #A8A9AD;
  --c-body-soft:   #7A7B7F;
  --c-divider:     rgba(168,169,173,0.18);
  --f-display:     'Cormorant Garamond', Georgia, serif;
  --f-headline:    'Montserrat', sans-serif;
  --f-body:        'DM Sans', sans-serif;
  --radius-full:   9999px;
}
body { background: var(--c-void); color: var(--c-body); font-family: var(--f-body); }
.wrap { max-width: 1280px; margin: 0 auto; padding: 0 56px; }
.hero {
  min-height: 100vh; position: relative;
  display: flex; align-items: center;
  padding: 80px 0; overflow: hidden;
  background: var(--c-void);
}
.hero-bg { position: absolute; inset: 0; pointer-events: none; }
.hero-radial {
  position: absolute; inset: 0;
  background:
    radial-gradient(ellipse 50% 65% at var(--mx, 75%) var(--my, 40%), rgba(28,68,140,0.7) 0%, transparent 60%),
    radial-gradient(ellipse 30% 40% at var(--mx2, 85%) var(--my2, 55%), rgba(201,168,76,0.08) 0%, transparent 50%);
  will-change: background;
}
.hero-layout {
  display: grid; grid-template-columns: 42% 1fr;
  align-items: center; gap: 56px;
  width: 100%; position: relative; z-index: 2;
}
.hero-photo-box {
  width: 100%; aspect-ratio: 3/4; border-radius: 18px; overflow: hidden;
  background: rgba(15,15,22,0.7); border: 1px solid var(--c-divider);
}
.hero-photo-box img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
.hero-badge {
  display: inline-flex; align-items: center; gap: 10px;
  background: rgba(201,168,76,0.08); border: 1px solid var(--c-gold-border);
  border-radius: var(--radius-full); padding: 8px 20px; margin-bottom: 36px;
}
.hero-badge-dot {
  width: 7px; height: 7px; border-radius: 50%; background: var(--c-gold);
  animation: dotPulse 2s ease-in-out infinite;
}
@keyframes dotPulse {
  0%,100% { opacity:1; transform:scale(1); box-shadow:0 0 0 0 rgba(201,168,76,0.4); }
  50%      { opacity:0.7; transform:scale(0.8); box-shadow:0 0 0 4px rgba(201,168,76,0); }
}
.hero-badge-text { font-size: 13px; font-weight: 500; color: var(--c-gold); letter-spacing: 0.03em; }
.hero-headline {
  font-family: var(--f-display); font-size: clamp(2.4rem, 4vw, 3.8rem);
  font-weight: 600; color: var(--c-headline);
  line-height: 1.1; margin-bottom: 28px; letter-spacing: -0.01em;
}
.hero-headline .gold { color: var(--c-gold); }
.hero-sub {
  font-size: 1.1rem; color: var(--c-body);
  line-height: 1.65; max-width: 560px; margin-bottom: 44px;
}
.hero-sub strong { color: var(--c-headline); font-weight: 600; }
.btn-primary {
  display: inline-flex; align-items: center;
  background: var(--c-gold); color: #0A0A0A;
  font-family: var(--f-headline); font-weight: 700;
  font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
  text-decoration: none; border: none; cursor: pointer;
  padding: 16px 36px; border-radius: 10px;
  box-shadow: 0 4px 20px rgba(201,168,76,0.45);
  transition: background 0.2s, box-shadow 0.3s, transform 0.2s;
}
.btn-primary:hover { background: #E8C96A; box-shadow: 0 8px 32px rgba(201,168,76,0.55); }
.btn-primary { transform-style: preserve-3d; will-change: transform; }
</style>
</head>
<body>
<section class="hero">
  <div class="hero-bg"><div class="hero-radial"></div></div>
  <div class="wrap">
    <div class="hero-layout">
      <div>
        <div class="hero-photo-box">
          <img src="data:image/png;base64," alt="Laurenz Offermanns">
        </div>
      </div>
      <div>
        <div class="hero-badge">
          <span class="hero-badge-dot"></span>
          <span class="hero-badge-text">Planbare Lead-Generierung für KI-Agenturen und –Berater</span>
        </div>
        <h1 class="hero-headline">
          Fülle deinen leeren Kalender mit qualifizierten<br>
          <span class="gold">Erstgesprächen</span> – ohne Preiskampf
        </h1>
        <p class="hero-sub">
          indem du als unentbehrlicher Premium-Anbieter scrollende KMU–Entscheider
          durch einen verkaufspsychologischen Online-Auftritt direkt in
          <strong>dein CRM</strong> laufen lässt
        </p>
        <a href="#formular" id="hero-cta" class="btn-primary">Ja, ich möchte verkaufsstarke Außenwirkung</a>
      </div>
    </div>
  </div>
</section>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script>
(function(){

  // ── 1. PARALLAX GLOW ──
  var hero=document.querySelector('.hero'), radial=document.querySelector('.hero-radial');
  if(hero && radial){
    var tx=75, ty=40;
    hero.addEventListener('mousemove',function(e){
      var r=hero.getBoundingClientRect();
      var mx=((e.clientX-r.left)/r.width)*100, my=((e.clientY-r.top)/r.height)*100;
      gsap.to({x:tx,y:ty},{x:mx,y:my,duration:0.6,ease:'power2.out',onUpdate:function(){
        tx=this.targets()[0].x; ty=this.targets()[0].y;
        radial.style.setProperty('--mx',tx.toFixed(1)+'%');
        radial.style.setProperty('--my',ty.toFixed(1)+'%');
        radial.style.setProperty('--mx2',(tx*0.9+10).toFixed(1)+'%');
        radial.style.setProperty('--my2',(ty*0.85+8).toFixed(1)+'%');
      }});
    });
    hero.addEventListener('mouseleave',function(){
      gsap.to({x:tx,y:ty},{x:75,y:40,duration:1.8,ease:'power3.out',onUpdate:function(){
        tx=this.targets()[0].x; ty=this.targets()[0].y;
        radial.style.setProperty('--mx',tx.toFixed(1)+'%');
        radial.style.setProperty('--my',ty.toFixed(1)+'%');
        radial.style.setProperty('--mx2',(tx*0.9+10).toFixed(1)+'%');
        radial.style.setProperty('--my2',(ty*0.85+8).toFixed(1)+'%');
      }});
    });
  }

  // ── 2. MAGNETIC CTA ──
  var cta = document.getElementById('hero-cta');
  if(cta){
    cta.addEventListener('mousemove', function(e){
      var r = cta.getBoundingClientRect();
      var x = (e.clientX - r.left - r.width  / 2) * 0.35;
      var y = (e.clientY - r.top  - r.height / 2) * 0.35;
      gsap.to(cta, { x:x, y:y, duration:0.35, ease:'power2.out' });
    });
    cta.addEventListener('mouseleave', function(){
      gsap.to(cta, { x:0, y:0, duration:0.7, ease:'elastic.out(1, 0.45)' });
    });

    // ── 3. SMOOTH SCROLL beim Klick ──
    cta.addEventListener('click', function(e){
      e.preventDefault();

      // OPTION A: Zu einem Element mit bestimmter ID scrollen
      // Ändere 'ziel-abschnitt' auf die tatsächliche ID deines Ziel-Abschnitts auf onepage.io
      var ziel = document.getElementById('formular');
      if(ziel){
        ziel.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }

      // OPTION B: onepage.io-Navigation (falls OPTION A nicht greift)
      // onepage.io nutzt intern window.onepage oder data-anchor Attribute
      var anchor = 'formular';
      var sectionEl = document.getElementById(anchor) || document.querySelector('[data-anchor="' + anchor + '"]') || document.querySelector('#' + anchor);
      if(sectionEl){
        sectionEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }

      // OPTION C: Direkt zum nächsten Abschnitt scrollen (universeller Fallback)
      var heroEl = document.querySelector('.hero') || cta.closest('section');
      if(heroEl && heroEl.nextElementSibling){
        heroEl.nextElementSibling.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  }

})();
</script>
</body>
</html>
