","media_src":"","media_alt":"","media_name":"","link_show_arrow":true,"collapsed":true},"styles":{"icon_type":"nucleo","padding_key":"custom","padding_custom":0}},{"_id":"0mqt8BHPzMsbNRQruECix","data":{"link_text":"Zum kostenlosen Erstgespräch","link_subtitle":"","link_action_type":"scroll","link_track_events":[],"link_href":"","link_blank":false,"link_mail_to":"","link_tel":"","link_scroll":"98404a64-67f1-40a5-b881-23101d5513c0","link_animate_scroll":false,"link_show_on_hover":false,"link_modal":"","link_megamenu":"","link_file":"","media_src":"","media_alt":"","media_name":"","link_show_arrow":true,"collapsed":true},"styles":{"icon_type":"nucleo","padding_key":"custom","padding_custom":0}}]},"styles":{"direction":"horizontal","size":"l","atom_width":40.81361970324393,"align_horizontal":"left","space_key":"s","font_family":"header","font_weight":600,"menu_v2_style_type":"color","color_text_variation":"text","color_text_alpha":1,"color_text_custom":"0,0,0"}},{"_id":"472ef0d7-4f32-4243-9f10-ab3dea137c75","position":1,"type":"logo","data":{"src":"media\u002F3ece0add-0116-4f38-b4b7-74cb1be3b909","name":"Bildschirmfoto_6-6-2026_145043_looka.com.jpeg","items":[],"text":"Laurenz Copywriting","alt":"Artus Richard Laurenz Partheymüller","action_type":"scroll","scroll":"Dg8fOSN6Eta1C6aKiKAjV"},"styles":{"logo_size":56,"atom_width":32.58,"align_horizontal":"left"}},{"_id":"1c2d7264-7b47-4129-81dc-cd94fe4cdccd","type":"custom-code","position":3,"data":{"html":"\u003C!DOCTYPE html\u003E\r\n\u003Chtml lang=\"de\"\u003E\r\n\u003Chead\u003E\r\n\u003Cmeta charset=\"UTF-8\"\u003E\r\n\u003Cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"\u003E\r\n\u003Clink rel=\"preconnect\" href=\"https:\u002F\u002Ffonts.googleapis.com\"\u003E\r\n\u003Clink rel=\"stylesheet\" href=\"https:\u002F\u002Ffonts.googleapis.com\u002Fcss2?family=Montserrat:wght@600;700;800&display=swap\"\u003E\r\n\u003Cstyle\u003E\r\n*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\r\n\r\n.lc-nav-cta-wrap {\r\n  \u002F* Positionierung: oben rechts in deiner Nav *\u002F\r\n  display: inline-flex;\r\n  align-items: center;\r\n}\r\n\r\n.lc-nav-cta {\r\n  display: inline-flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: 2px;\r\n  background: #C9A84C;\r\n  color: #ffffff;\r\n  font-family: 'Montserrat', sans-serif;\r\n  font-weight: 700;\r\n  font-size: 11px;\r\n  letter-spacing: 0.18em;\r\n  text-transform: uppercase;\r\n  text-decoration: none;\r\n  border: none;\r\n  cursor: pointer;\r\n  padding: 12px 28px;\r\n  border-radius: 10px;\r\n  box-shadow: 0 4px 20px rgba(201,168,76,0.45);\r\n  line-height: 1.2;\r\n  will-change: transform;\r\n  transition: background 0.2s, box-shadow 0.3s;\r\n}\r\n.lc-nav-cta:hover {\r\n  background: #E8C96A;\r\n  box-shadow: 0 8px 32px rgba(201,168,76,0.55);\r\n}\r\n.lc-nav-cta-sub {\r\n  font-size: 9px;\r\n  font-weight: 500;\r\n  letter-spacing: 0.06em;\r\n  color: rgba(255,255,255,0.6);\r\n  text-transform: none;\r\n}\r\n\r\n\u002F* Glanzschweif *\u002F\r\n.lc-nav-cta {\r\n  overflow: hidden;\r\n  position: relative;\r\n}\r\n.lc-nav-cta::after {\r\n  content: '';\r\n  position: absolute;\r\n  top: 0; left: -75%;\r\n  width: 50%; height: 100%;\r\n  background: linear-gradient(\r\n    120deg,\r\n    transparent 0%,\r\n    rgba(255,255,255,0.55) 50%,\r\n    transparent 100%\r\n  );\r\n  transform: skewX(-20deg);\r\n  animation: navShine 2.5s ease-in-out infinite;\r\n  pointer-events: none;\r\n}\r\n@keyframes navShine {\r\n  0%   { left: -75%; opacity: 0; }\r\n  8%   { opacity: 1; }\r\n  38%  { left: 130%; opacity: 0; }\r\n  100% { left: 130%; opacity: 0; }\r\n}\r\n\u003C\u002Fstyle\u003E\r\n\u003C\u002Fhead\u003E\r\n\u003Cbody\u003E\r\n\r\n\u003C!-- ═══ NAV CTA ═══ --\u003E\r\n\u003Cdiv class=\"lc-nav-cta-wrap\"\u003E\r\n  \u003Ca href=\"#formular\" id=\"nav-cta\" class=\"lc-nav-cta\"\u003E\r\n    Potenzialanalyse buchen\r\n    \u003Cspan class=\"lc-nav-cta-sub\"\u003E100% kostenlos &amp; unverbindlich\u003C\u002Fspan\u003E\r\n  \u003C\u002Fa\u003E\r\n\u003C\u002Fdiv\u003E\r\n\r\n\u003C!-- Magnetischer Hover + Scroll zu \"formular\" --\u003E\r\n\u003Cscript src=\"https:\u002F\u002Fcdnjs.cloudflare.com\u002Fajax\u002Flibs\u002Fgsap\u002F3.12.2\u002Fgsap.min.js\"\u003E\u003C\u002Fscript\u003E\r\n\u003Cscript\u003E\r\n(function(){\r\n  var cta = document.getElementById('nav-cta');\r\n  if(!cta) return;\r\n\r\n  \u002F\u002F ── Magnetischer Hover ──\r\n  cta.addEventListener('mousemove', function(e){\r\n    var r = cta.getBoundingClientRect();\r\n    var x = (e.clientX - r.left - r.width  \u002F 2) * 0.35;\r\n    var y = (e.clientY - r.top  - r.height \u002F 2) * 0.35;\r\n    gsap.to(cta, { x:x, y:y, duration:0.35, ease:'power2.out' });\r\n  });\r\n  cta.addEventListener('mouseleave', function(){\r\n    gsap.to(cta, { x:0, y:0, duration:0.7, ease:'elastic.out(1, 0.45)' });\r\n  });\r\n\r\n  \u002F\u002F ── Scroll zu onepage.io Abschnitt \"formular\" ──\r\n  cta.addEventListener('click', function(e){\r\n    e.preventDefault();\r\n    var anchor = 'formular';\r\n\r\n    \u002F\u002F OPTION A: Element mit id=\"formular\"\r\n    var ziel = document.getElementById(anchor);\r\n    if(ziel){ ziel.scrollIntoView({ behavior:'smooth', block:'start' }); return; }\r\n\r\n    \u002F\u002F OPTION B: onepage.io data-anchor Attribut\r\n    var sectionEl = document.querySelector('[data-anchor=\"' + anchor + '\"]');\r\n    if(sectionEl){ sectionEl.scrollIntoView({ behavior:'smooth', block:'start' }); return; }\r\n\r\n    \u002F\u002F OPTION C: Nächster Abschnitt als Fallback\r\n    var nav = cta.closest('nav') || cta.closest('header');\r\n    if(nav && nav.nextElementSibling){\r\n      nav.nextElementSibling.scrollIntoView({ behavior:'smooth', block:'start' });\r\n    }\r\n  });\r\n})();\r\n\u003C\u002Fscript\u003E\r\n\r\n\u003C\u002Fbody\u003E\r\n\u003C\u002Fhtml\u003E","css":"","js":"","scss":""},"styles":{"logo_size":23,"atom_width":47.246995681371445}}]}]}]}]}},{"_