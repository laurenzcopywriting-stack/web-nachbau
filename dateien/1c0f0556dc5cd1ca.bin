:13px;--one-kit-padding-vertical:5px;--one-kit-padding-horizontal:20px;--one-kit-height:40px" class="con-kit-link-button con-kit-component-button con-kit-component-button--type-transparent con-kit-component-button--animation-none con-kit-component-button--icon con-kit-component-list-item-accordion__toggle" data-kit-radius="4" data-kit-atom-border-type="solid" data-kit-infinite-animation="none" data-kit-transparent-button-effect="underline" aria-controls="accordion-body-mQ8DuWlylWo9cHsUqowm5" aria-expanded="false" aria-labelledby="accordion-header-mQ8DuWlylWo9cHsUqowm5" type="button" draggable="false"><div aria-hidden="true" class="con-kit-component-icon con-kit-component-icon--style-transparent con-kit-component-icon--size-m" data-icon-info="arrow-sm-down outline" data-kit-atom-border-type="solid" style="--component-icon__line-weight:0.8171428571428571px;--component-icon__svg-size:16"><span class="con-kit-component-icon__border" data-kit-radius="100" style="--one-kit-radius:100px"></span><svg viewBox="0 0 16 16" preserveAspectRatio="none"><polyline fill="none" data-stroke="#444444" stroke-linecap="round" stroke-linejoin="round" stroke-miterlimit="10" points="3.5,6.5 8,11 12.5,6.5 "></polyline></svg></div></button></div></div><div id="accordion-body-mQ8DuWlylWo9cHsUqowm5" class="con-kit-component-list-item-accordion__body" style="height:0" role="region" aria-labelledby="accordion-header-mQ8DuWlylWo9cHsUqowm5" aria-hidden="true"><div class="con-kit-component-list-item-accordion__body2" tabindex="-1"><div class="con-kit-component-list-plain" data-font-kit-type="m" style="--color-text:10,10,10;--alpha-text:0.48;--color-bg:245,240,232;--alpha-bg:1;--color-border:245,240,232;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;light&quot;,&quot;colorBgType&quot;:&quot;palette&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[245,240,232],&quot;colorBgVariant&quot;:&quot;__root&quot;,&quot;colorText&quot;:&quot;dark&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:0.48,&quot;colorTextFormat&quot;:[10,10,10],&quot;colorTextVariant&quot;:&quot;text&quot;}"></div><div class="con-kit-component-text" data-text-prop="plain_text" data-font-kit-type="m" data-style-prefix="plain_"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="8m1sv">Meine Angebote variieren, weil sie so individuell sind wie die Kunden, die ich betreue. </div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="frd32">Je nachdem, was für dein Business aktuell der größte Hebel ist, gibt es verschiedene Ansätze zur Neukundengewinnung, Erhalt der Stammkunden sowie Steigerung der Kundenqualität und des Kundenwerts: </div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="3gjc">Landing Pages, Website Pages,, Newsletter, Social Media Posts, Ads etc.</div></div></div></div></div></div></div><div class="con-kit-component-grid-list-item con-kit-animation__item con-kit-component-grid-list-item--first-in-row con-kit-component-grid-list-item--last-in-row con-kit-animation__grid_item" style="--one-kit-animation-item-delay:1s"><div class="con-kit-component-list-item-accordion" data-kit-frame="lineTopBottom" data-kit-radius="4" style="--one-kit-padding:32px;--one-kit-radius:4px" data-list-item-index="1"><div class="con-kit-component-list-item-accordion__head"><div class="con-kit-component-list-item__header" id="accordion-header-I3ovuTVX7wLF5G1V5B5hh"><div class="con-kit-component-list-header" style="--color-text:10,10,10;--alpha-text:1;--color-bg:245,240,232;--alpha-bg:1;--color-border:245,240,232;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;light&quot;,&quot;colorBgType&quot;:&quot;palette&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[245,240,232],&quot;colorBgVariant&quot;:&quot;__root&quot;,&quot;colorText&quot;:&quot;dark&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[10,10,10],&quot;colorTextVariant&quot;:&quot;text&quot;}"></div><div class="con-kit-component-header con-kit-component-header--subheader" data-text-prop="header_text" data-style-prefix="header_" data-font-kit-type="m"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="8m1sv">Was ist deine Qualifikation?</div></div></div></div><div class="con-kit-component-list-item-accordion__trigger"><button style="--color-text:10,10,10;--alpha-text:1;--color-bg:245,240,232;--alpha-bg:1;--color-border:245,240,232;--alpha-border:1;--one-kit-radius:4px;--font-kit-line-height:var(--font-kit-text-line-height);--font-kit-letter-spacing:var(--font-kit-text-letter-spacing);--font-kit-text-transform:var(--font-kit-text-transform);--button-size:13px;--one-kit-padding-vertical:5px;--one-kit-padding-horizontal:20px;--one-kit-height:40px" class="con-kit-link-button con-kit-component-button con-kit-component-button--type-transparent con-kit-component-button--animation-none con-kit-component-button--icon con-kit-component-list-item-accordion__toggle" data-kit-radius="4" data-kit-atom-border-type="solid" data-kit-infinite-animation="none" data-kit-transparent-button-effect="underline" aria-controls="accordion-body-I3ovuTVX7wLF5G1V5B5hh" aria-expanded="false" aria-labelledby="accordion-header-I3ovuTVX7wLF5G1V5B5hh" type="button" draggable="false"><div aria-hidden="true" class="con-kit-component-icon con-kit-component-icon--style-transparent con-kit-component-icon--size-m" data-icon-info="arrow-sm-down outline" data-kit-atom-border-type="solid" style="--component-icon__line-weight:0.8171428571428571px;--component-icon__svg-size:16"><span class="con-kit-component-icon__border" data-kit-radius="100" style="--one-kit-radius:100px"></span><svg viewBox="0 0 16 16" preserveAspectRatio="none"><polyline fill="none" data-stroke="#444444" stroke-linecap="round" stroke-linejoin="round" stroke-miterlimit="10" points="3.5,6.5 8,11 12.5,6.5 "></polyline></svg></div></button></div></div><div id="accordion-body-I3ovuTVX7wLF5G1V5B5hh" class="con-kit-component-list-item-accordion__body" style="height:0" role="region" aria-labelledby="accordion-header-I3ovuTVX7wLF5G1V5B5hh" aria-hidden="true"><div class="con-kit-component-list-item-accordion__body2" tabindex="-1"><div class="con-kit-component-list-plain" data-font-kit-type="m" style="--color-text:10,10,10;--alpha-text:0.48;--color-bg:245,240,232;--alpha-bg:1;--color-border:245,240,232;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;light&quot;,&quot;colorBgType&quot;:&quot;palette&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[245,240,232],&quot;colorBgVariant&quot;:&quot;__root&quot;,&quot;colorText&quot;:&quot;dark&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:0.48,&quot;colorTextFormat&quot;:[10,10,10],&quot;colorTextVariant&quot;:&quot;text&quot;}"></div><div class="con-kit-component-text" data-text-prop="plain_text" data-font-kit-type="m" data-style-prefix="plain_"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="8m1sv">Ich durfte mein Wissen und praktische Expertise im verkaufspsychologischen Texten beim Marktführer Deutschlands (laut eigenen Angaben des Anbieters) erlernen: der Copywriting MBA mit Unternehmenssitz in Düsseldorf.</div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="e7al7">Doch selbst die beste Theorie zeigt noch keine spürbaren Ergebnisse. Deshalb bin ich sehr dankbar nach meiner Online-Marketing-Ausbildung 10+ Kunden begleitet haben zu dürfen, damit sie mit einem optimierten Online-Auftritt mehr Kunden gewinnen.</div></div></div></div></div></div></div><div class="con-kit-component-grid-list-item con-kit-animation__item con-kit-component-grid-list-item--first-in-row con-kit-component-grid-list-item--last-in-row con-kit-animation__grid_item" style="--one-kit-animation-item-delay:2s"><div class="con-kit-component-list-item-accordion" data-kit-frame="lineTopBottom" data-kit-radius="4" style="--one-kit-padding:32px;--one-kit-radius:4px" data-list-item-index="2"><div class="con-kit-component-list-item-accordion__head"><div class="con-kit-component-list-item__header" id="accordion-header-Mcqz7t4YrTxCK6iKDLJU8"><div class="con-kit-component-list-header" style="--color-text:10,10,10;--alpha-text:1;--color-bg:245,240,232;--alpha-bg:1;--color-border:245,240,232;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;light&quot;,&quot;colorBgType&quot;:&quot;palette&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[245,240,232],&quot;colorBgVariant&quot;:&quot;__root&quot;,&quot;colorText&quot;:&quot;dark&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[10,10,10],&quot;colorTextVariant&quot;:&quot;text&quot;}"></div><div class="con-kit-component-header con-kit-component-header--subheader" data-text-prop="header_text" data-style-prefix="header_" data-font-kit-type="m"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="8m1sv">Wer pflegt die optimierten Inhalte dann ein?</div></div></div></div><div class="con-kit-component-list-item-accordion__trigger"><button style="--color-text:10,10,10;--alpha-text:1;--color-bg:245,240,232;--alpha-bg:1;--color-border:245,240,232;--alpha-border:1;--one-kit-radius:4px;--font-kit-line-height:var(--font-kit-text-line-height);--font-kit-letter-spacing:var(--font-kit-text-letter-spacing);--font-kit-text-transform:var(--font-kit-text-transform);--button-size:13px;--one-kit-padding-vertical:5px;--one-kit-padding-horizontal:20px;--one-kit-height:40px" class="con-kit-link-button con-kit-component-button con-kit-component-button--type-transparent con-kit-component-button--animation-none con-kit-component-button--icon con-kit-component-list-item-accordion__toggle" data-kit-radius="4" data-kit-atom-border-type="solid" data-kit-infinite-animation="none" data-kit-transparent-button-effect="underline" aria-controls="accordion-body-Mcqz7t4YrTxCK6iKDLJU8" aria-expanded="false" aria-labelledby="accordion-header-Mcqz7t4YrTxCK6iKDLJU8" type="button" draggable="false"><div aria-hidden="true" class="con-kit-component-icon con-kit-component-icon--style-transparent con-kit-component-icon--size-m" data-icon-info="arrow-sm-down outline" data-kit-atom-border-type="solid" style="--component-icon__line-weight:0.8171428571428571px;--component-icon__svg-size:16"><span class="con-kit-component-icon__border" data-kit-radius="100" style="--one-kit-radius:100px"></span><svg viewBox="0 0 16 16" preserveAspectRatio="none"><polyline fill="none" data-stroke="#444444" stroke-linecap="round" stroke-linejoin="round" stroke-miterlimit="10" points="3.5,6.5 8,11 12.5,6.5 "></polyline></svg></div></button></div></div><div id="accordion-body-Mcqz7t4YrTxCK6iKDLJU8" class="con-kit-component-list-item-accordion__body" style="height:0" role="region" aria-labelledby="accordion-header-Mcqz7t4YrTxCK6iKDLJU8" aria-hidden="true"><div class="con-kit-component-list-item-accordion__body2" tabindex="-1"><div class="con-kit-component-list-plain" data-font-kit-type="m" style="--color-text:10,10,10;--alpha-text:0.48;--color-bg:245,240,232;--alpha-bg:1;--color-border:245,240,232;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;light&quot;,&quot;colorBgType&quot;:&quot;palette&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[245,240,232],&quot;colorBgVariant&quot;:&quot;__root&quot;,&quot;colorText&quot;:&quot;dark&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:0.48,&quot;colorTextFormat&quot;:[10,10,10],&quot;colorTextVariant&quot;:&quot;text&quot;}"></div><div class="con-kit-component-text" data-text-prop="plain_text" data-font-kit-type="m" data-style-prefix="plain_"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="8m1sv">Natürlich werden die Leistungen nicht als Word-Datei o.ä. geliefert, sondern im verkaufspsychologischen Layout mit passender Anordnung, Form und Farbe - wie eine exakte Kopie deiner Seite (nur eben mit neuen Inhalten). Andernfalls kann ich die Inhalte auch einpflegen, wenn du das möchtest und die Art deines Website-Anbieter es zulässt.</div></div></div></div></div></div></div><div class="con-kit-component-grid-list-item con-kit-animation__item con-kit-component-grid-list-item--last-row con-kit-component-grid-list-item--last-of-row con-kit-component-grid-list-item--first-in-row con-kit-component-grid-list-item--last-in-row con-kit-animation__grid_item" style="--one-kit-animation-item-delay:3s"><div class="con-kit-component-list-item-accordion" data-kit-frame="lineTopBottom" data-kit-radius="4" style="--one-kit-padding:32px;--one-kit-radius:4px" data-list-item-index="3"><div class="con-kit-component-list-item-accordion__head"><div class="con-kit-component-list-item__header" id="accordion-header-0Ex_FdbvkD3OZu5YdAXyz"><div class="con-kit-component-list-header" style="--color-text:10,10,10;--alpha-text:1;--color-bg:245,240,232;--alpha-bg:1;--color-border:245,240,232;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;light&quot;,&quot;colorBgType&quot;:&quot;palette&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[245,240,232],&quot;colorBgVariant&quot;:&quot;__root&quot;,&quot;colorText&quot;:&quot;dark&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[10,10,10],&quot;colorTextVariant&quot;:&quot;text&quot;}"></div><div class="con-ki