-last con-kit-col--first" data-col-lg="24" data-col-md="24" data-col-sm="24"><div data-id="637ad5be-eefc-4c87-a804-a45649a96ffb" data-molecule="grid" style="width:100%"><div class="con-kit-component-marquee" style="--marquee-speed:0s;overflow-x:hidden"><div class="con-kit-component-marquee__content"><div class="con-kit-component-marquee-grid con-kit-component-marquee-grid--columns-3" style="--one-kit-image-height:200px"><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:0s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="6dec51ce-4ca0-4f76-9131-b70b54c6ff2f" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="70426003-5ebb-4174-bcff-4ca90b1b906d" data-position="1" data-parent-id="bb3db209-ce4d-446f-8bd1-a3dba8a471b9" data-mode="vertical" data-atom-horizontal="center" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:8px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="custom" style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,179,224;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,179,224],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="custom"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" data-kit-align-horizontal="center" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="MbFOB4YsTg">Eine Frau leidet unter einem Speicheldrüsenlrebs, der nicht operiert werden konnte. </div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" data-kit-align-horizontal="center" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="f1lb2">Durch Arbeit mit Qodes und BoosterGane wurde er operabel und ist ausgeheilt.</div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="4pst5"><br/></div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="8jvaa"><br/></div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="6beqb"><br/></div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:1s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="661f22d3-e9c4-4132-b0dd-3202cb99d542" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="add3564e-3750-49c4-b8a8-8be035bd70b8" data-position="1" data-parent-id="bb3db209-ce4d-446f-8bd1-a3dba8a471b9" data-mode="vertical" data-atom-horizontal="center" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:8px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="custom" style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,179,224;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,179,224],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="custom"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="8m1sv">Litt an schwerster Neurodermitis, einem Aneurysma im Kopf sowie an ständiger Angst und Überarbeitung. Heute ist sie wie erblüht: selbstbewusst, fröhlich und frei. Sie gestaltet ihr Leben aktiv, meistert selbst größte Herausforderungen spielerisch und verfügt mit der GienowMethode über ein DIY-Gesundheitssystem, das ihr kontinuierliches Wachstum und ihre Gesundheit unterstützt.</div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="1s390">
- Christiane B.</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:2s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="5fa9df53-a288-490d-ab30-48c85f002c70" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="d5380ce5-ef91-4fcc-8b88-62caa40fa745" data-position="1" data-parent-id="bb3db209-ce4d-446f-8bd1-a3dba8a471b9" data-mode="vertical" data-atom-horizontal="center" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:8px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="custom" style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,179,224;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,179,224],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="custom"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="8m1sv">Nach der ersten Pilleneinnahme entwickelte eine 16-Jährige starke Nebenwirkungen, darunter einen schmerzhaften Speichelstein. Trotz Cortison, Antibiotika, geplanter OP und Skepsis gegenüber BoosterGane entschied sie sich, abzuwarten. </div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="efkrl">Durch den Steinbeißerbuddha und den passenden Qode löste sich der Stein schließlich von selbst – nach drei Wochen war sie völlig beschwerdefrei und fand mit ihrem Freund eine bessere Alternative zur Pille.</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:3s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="855a05de-22d0-4f7c-a44c-870712628fb5" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="cf85f531-eea4-4092-a7ec-d86ffea414a7" data-position="1" data-parent-id="bb3db209-ce4d-446f-8bd1-a3dba8a471b9" data-mode="vertical" data-atom-horizontal="center" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:8px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="custom" style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,179,224;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,179,224],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="custom"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="8m1sv">Beim Training erlitt eine Klientin einen Hexenschuss.
Früher hatte sie oft Bandscheibenprobleme, seit der GienowMethode jedoch nicht mehr.
Erst nahm sie aus Gewohnheit ein Schmerzmittel, dann erinnerte sie sich an die Fingergeste für Hexenschuss.

&quot;Gudrun, du glaubst es nicht: Sofort waren die Schmerzen um 90% besser und am Abend ganz weg.&quot;</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:4s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="2b1ef5e5-ff2b-4d36-8a7b-2f7dede3bd94" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="24119cd9-9233-427b-b37f-723427b34895" data-position="1" data-parent-id="bb3db209-ce4d-446f-8bd1-a3dba8a471b9" data-mode="vertical" data-atom-horizontal="center" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:8px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="custom" style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,179,224;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,179,224],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="custom"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="8m1sv">Ein inoperabler Speicheldrüsenkrebs, der durch die Arbeit mit Qodes und BoosterGane operabel wurde und ausgeheilt ist.

</div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="ev2ak"><br/></div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="31apk"><br/></div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="3eg2t">Patientin von Dr. Hasler </div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:5s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="5a7ec338-7eaf-41da-b401-3bcac7b9fafd" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="c3415ecb-1927-4ec8-b5f9-fe8434d2613d" data-position="1" data-parent-id="bb3db209-ce4d-446f-8bd1-a3dba8a471b9" data-mode="vertical" data-atom-horizontal="center" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:8px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="custom" style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,179,224;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,179,224],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="custom"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="8m1sv">Ein Patient hat ein Jahr lang den Nachtfalter immer mal wieder angesehen und hatte das ganze Jahr keine von seinen ewigen Infekten mit chronischer Sinusitis. </div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="53m10">Er ist völlig begeistert. In einer neuen Verarbeitungsebene mit seinen seelisch belastenden Prozessen in einer Umgebung taucht nun die Sinusitis wieder auf mit Herzbeschwerden. Nun gesellt sich GammaEi als GertieGan dazu.</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:6s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="7b91fe84-cd1c-4de0-a93b-763d6407293f" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="32bae729-f148-4b02-ac32-701b1bbd3dd0" data-position="1" data-parent-id="bb3db209-ce4d-446f-8bd1-a3dba8a471b9" data-mode="vertical" data-atom-horizontal="center" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:8px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="custom" style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,179,224;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,179,224],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="custom"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="8m1sv">GG Super Mario Magen: Einen Klienten habe ich Super Mario Magen empfohlen, er sagte das sich jedes Problem immer auf seinen Magen schlägt und das war schon immer so. Er arbeitete intensiv mit GG Super Mario Magen und berichtete nach einiger Zeit dass er die Hähnchen mit Knochen die auf dem GG abgebildet sind, gespürt habe als hätte er sie persönlich verdaut. Nach dieser wunderbaren Erfahrung hat er keine stressbedingten Magenprobleme mehr.</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:7s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="5ebdb738-5a84-4532-a2d6-8e69d6b36d8f" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="40f87e6d-0a7e-4149-898a-fcd90bf97fa9" data-position="1" data-parent-id="bb3db209-ce4d-446f-8bd1-a3dba8a471b9" data-mode="vertical" data-atom-horizontal="center" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:8px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="custom" style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,179,224;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,179,224],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="custom"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="8m1sv">&quot;In Zeiten in denen ich nicht wusste, warum mir wieder dasselbe passiert, obwohl ich es nicht mehr möchte, konnte ich durch die Qodes meine Verhaltens-und Denkmuster kontinuierliche verändern.&quot;</div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="7eb0i"><br/></div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="3n4ok"><br/></div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="5iik6">
Ingrid</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:8s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="80db1ab0-e196-401c-9f81-a58afa6d2659" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="0efa59db-f3e5-472e-8657-e3c960b1658b" data-position="1" data-parent-id="bb3db209-ce4d-446f-8bd1-a3dba8a471b9" data-mode="vertical" data-atom-horizontal="center" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:8px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="custom" style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,179,224;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,179,224],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="custom"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="8m1sv">Liebe Gertie, Das GertieGan MuschelPuschel hat mir bei meiner Ischilagie supergut geholfen. Ich hatte mir beim Gießkanne anheben einen Hexenschuss zugezogen, der durch ruhe alleine nicht besser wurde. Nach 2 Tagen hole ich mir das GertieGan MuschelPuschel um meine Wirbelkörper wieder zu sortieren und an die richtige Stelle zu bringen. Nach 1 Stunde war der Schmerz verschwunden und nur noch ein leichtes angestrengtes Gefühl in der Region geblieben, das am nächsten Tag verschwunden war. Ein Segen! Alles Liebe Gudrun</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:9s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="0aa4a82d-9e7d-4024-aa9c-c31d3f3368d7" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="0a130f6b-a389-4b61-810c-8f19812841cb" data-position="1" data-parent-id="bb3db209-ce4d-446f-8bd1-a3dba8a471b9" data-mode="vertical" data-atom-horizontal="center" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:8px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="custom" style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,179,224;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,179,224],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="custom"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="8m1sv">Eine Klientin hat Burnout-Symptome und lies sich krankschreiben. Sie klagte über Konzentrationsschwäche und Zitat: &quot;wuselig im Kopf &quot; Sie hätte keine Klarheit und keinen Focus mehr. Daraufhin empfahl ich Ihr das GG Graf Tatterfit und es stellte sich sofort Besserung ein. Jetzt ist Sie wieder Fröhlich und denkt darüber nach wieder zu arbeiten.</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:10s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="7d78bab1-1264-4fa3-867e-a2442ccfe017" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="8a7d3059-23f1-4b02-9a63-97a41c6ebd59" data-position="1" data-parent-id="bb3db209-ce4d-446f-8bd1-a3dba8a471b9" data-mode="vertical" data-atom-horizontal="center" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:8px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="custom" style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,179,224;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,179,224],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="custom"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="8m1sv">Epilepsiepatientin die in extreme Stress-Situation kommt und massive Aussetzer (Vorstufe die sie spürt vor Anfall) produziert, trotz medikamentöser Notfallmitteln keine Besserung. Mit Fingerstellung und Empfangschefin werden die Aussetzer sofort weniger, unterstützt durch Ruhe sind die Aussetzer bis zum Abend komplett weg. Danke!</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:11s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="612d8c84-f531-4042-90ed-fb3fa44c7915" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="ad0028e5-1df5-4849-995e-13e8dbf86455" data-position="1" data-parent-id="bb3db209-ce4d-446f-8bd1-a3dba8a471b9" data-mode="vertical" data-atom-horizontal="center" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:8px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="custom" style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,179,224;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,179,224],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="custom"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="8m1sv">Ihr Lieben, hier ein Feedback von Peitschenelli: ein 88 jähriger Herr hat bereits wochenlang Blut im Urin. Mal hellrot, mal ganz dunkelblutig. Weil es ihm sehr gut geht und er darüberhinaus keine Beschwerden hat, will er sich nicht untersuchen lassen. Er schaut aber Peitschenelli an und der Urin wird am selben Tag wieder klar und bleibt klar.

Liebesgrüße und große Dankbarkeit an die Autorin Gertie</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:12s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="e4883c68-d7fb-4e30-ab43-85f266f38e6a" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="f8e45e74-a720-4221-87a4-9c80f1149bae" data-position="1" data-parent-id="bb3db209-ce4d-446f-8bd1-a3dba8a471b9" data-mode="vertical" data-atom-horizontal="center" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:8px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="custom" style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,179,224;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,179,224],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="custom"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="8m1sv">Seit einigen Tagen habe ich keine Schwindelgefühle mehr und ich fühle mich insgesamt gut bei Kräften – auch im Kopf… Das BoosterGan liegt weiterhin auf meinem Schreibtisch, so dass immer wieder mein Blick darauf fällt. Besten Dank für deine Hilfe</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:13s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="9bb6bb6b-98b5-44ee-b96c-577d0f91768e" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="e93ae6d4-da10-47dd-a73a-15e74d18a63e" data-position="1" data-parent-id="bb3db209-ce4d-446f-8bd1-a3dba8a471b9" data-mode="vertical" data-atom-horizontal="center" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:8px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="custom" style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,179,224;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,179,224],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="custom"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="8m1sv">38-jährige Patientin (Behandlungsbeginn vor ca. 3Wochen) – MS, Schwäche rechtes Bein nach längerem Laufen, dringende Empfehlung um nichts zu verpassen: Krankenhaus zur Cortison-Infusionstherapie für 3-5 Tage, vermutlich akuter MS-Schub. 2 Tage vor Klinikuntersuchung Beginn mit den Superhelden -&gt; Neurologisch keine Auffälligkeiten – wird am gleichen Tag ohne Therapie wieder entlassen ;-))). Die Superhelden haben so gut gearbeitet, da ist jegliche Überredungskunst als Therapeut unnötig! Phänomenal!!! Lieben Dank!</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:14s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="bbf8ceb2-9d4a-4a8a-8e47-e384481452bc" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="da30bffe-1387-4f22-b641-eccb78e4ad88" data-position="1" data-parent-id="bb3db209-ce4d-446f-8bd1-a3dba8a471b9" data-mode="vertical" data-atom-horizontal="center" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:8px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="custom" style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,179,224;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,179,224],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="custom"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="8m1sv"> Ich wollte kurz wegen meiner Stimme berichten. Bei dem BoosterGan hatte ich das Gefühl, dass es mir gut tut es anzusehen. Kigibili-Code habe ich auch gemacht. Meine Stimmprobleme sind nicht weg, aber besser.</div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="emifi"><br/></div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="aifi5"><br/></div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="et297"><br/></div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div></div><div class="con-kit-component-marquee__repeat" style="transform:translateX(100%);width:0px"><div class="con-kit-component-marquee-grid con-kit-component-marquee-grid--columns-3" style="--one-kit-image-height:200px"><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:0s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="6dec51ce-4ca0-4f76-9131-b70b54c6ff2f" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="70426003-5ebb-4174-bcff-4ca90b1b906d" data-position="1" data-parent-id="bb3db209-ce4d-446f-8bd1-a3dba8a471b9" data-mode="vertical" data-atom-horizontal="center" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:8px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="custom" style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,179,224;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,179,224],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="custom"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" data-kit-align-horizontal="center" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="MbFOB4YsTg">Eine Frau leidet unter einem Speicheldrüsenlrebs, der nicht operiert werden konnte. </div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" data-kit-align-horizontal="center" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="f1lb2">Durch Arbeit mit Qodes und BoosterGane wurde er operabel und ist ausgeheilt.</div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="4pst5"><br/></div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="8jvaa"><br/></div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="6beqb"><br/></div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:1s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="661f22d3-e9c4-4132-b0dd-3202cb99d542" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="add3564e-3750-49c4-b8a8-8be035bd70b8" data-position="1" data-parent-id="bb3db209-ce4d-446f-8bd1-a3dba8a471b9" data-mode="vertical" data-atom-horizontal="center" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:8px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="custom" style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,179,224;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,179,224],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="custom"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="8m1sv">Litt an schwerster Neurodermitis, einem Aneurysma im Kopf sowie an ständiger Angst und Überarbeitung. Heute ist sie wie erblüht: selbstbewusst, fröhlich und frei. Sie gestaltet ihr Leben aktiv, meistert selbst größte Herausforderungen spielerisch und verfügt mit der GienowMethode über ein DIY-Gesundheitssystem, das ihr kontinuierliches Wachstum und ihre Gesundheit unterstützt.</div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="1s390">
- Christiane B.</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:2s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="5fa9df53-a288-490d-ab30-48c85f002c70" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="d5380ce5-ef91-4fcc-8b88-62caa40fa745" data-position="1" data-parent-id="bb3db209-ce4d-446f-8bd1-a3dba8a471b9" data-mode="vertical" data-atom-horizontal="center" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:8px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="custom" style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,179,224;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,179,224],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="custom"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="8m1sv">Nach der ersten Pilleneinnahme entwickelte eine 16-Jährige starke Nebenwirkungen, darunter einen schmerzhaften Speichelstein. Trotz Cortison, Antibiotika, geplanter OP und Skepsis gegenüber BoosterGane entschied sie sich, abzuwarten. </div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="efkrl">Durch den Steinbeißerbuddha und den passenden Qode löste sich der Stein schließlich von selbst – nach drei Wochen war sie völlig beschwerdefrei und fand mit ihrem Freund eine bessere Alternative zur Pille.</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:3s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="855a05de-22d0-4f7c-a44c-870712628fb5" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="cf85f531-eea4-4092-a7ec-d86ffea414a7" data-position="1" data-parent-id="bb3db209-ce4d-446f-8bd1-a3dba8a471b9" data-mode="vertical" data-atom-horizontal="center" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:8px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="custom" style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,179,224;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,179,224],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="custom"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="8m1sv">Beim Training erlitt eine Klientin einen Hexenschuss.
Früher hatte sie oft Bandscheibenprobleme, seit der GienowMethode jedoch nicht mehr.
Erst nahm sie aus Gewohnheit ein Schmerzmittel, dann erinnerte sie sich an die Fingergeste für Hexenschuss.

&quot;Gudrun, du glaubst es nicht: Sofort waren die Schmerzen um 90% besser und am Abend ganz weg.&quot;</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:4s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="2b1ef5e5-ff2b-4d36-8a7b-2f7dede3bd94" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="24119cd9-9233-427b-b37f-723427b34895" data-position="1" data-parent-id="bb3db209-ce4d-446f-8bd1-a3dba8a471b9" data-mode="vertical" data-atom-horizontal="center" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:8px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="custom" style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,179,224;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,179,224],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="custom"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="8m1sv">Ein inoperabler Speicheldrüsenkrebs, der durch die Arbeit mit Qodes und BoosterGane operabel wurde und ausgeheilt ist.

</div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="ev2ak"><br/></div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="31apk"><br/></div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="3eg2t">Patientin von Dr. Hasler </div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:5s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="5a7ec338-7eaf-41da-b401-3bcac7b9fafd" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="c3415ecb-1927-4ec8-b5f9-fe8434d2613d" data-position="1" data-parent-id="bb3db209-ce4d-446f-8bd1-a3dba8a471b9" data-mode="vertical" data-atom-horizontal="center" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:8px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="custom" style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,179,224;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,179,224],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="custom"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="8m1sv">Ein Patient hat ein Jahr lang den Nachtfalter immer mal wieder angesehen und hatte das ganze Jahr keine von seinen ewigen Infekten mit chronischer Sinusitis. </div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="53m10">Er ist völlig begeistert. In einer neuen Verarbeitungsebene mit seinen seelisch belastenden Prozessen in einer Umgebung taucht nun die Sinusitis wieder auf mit Herzbeschwerden. Nun gesellt sich GammaEi als GertieGan dazu.</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:6s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="7b91fe84-cd1c-4de0-a93b-763d6407293f" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="32bae729-f148-4b02-ac32-701b1bbd3dd0" data-position="1" data-parent-id="bb3db209-ce4d-446f-8bd1-a3dba8a471b9" data-mode="vertical" data-atom-horizontal="center" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:8px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="custom" style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,179,224;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,179,224],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="custom"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="8m1sv">GG Super Mario Magen: Einen Klienten habe ich Super Mario Magen empfohlen, er sagte das sich jedes Problem immer auf seinen Magen schlägt und das war schon immer so. Er arbeitete intensiv mit GG Super Mario Magen und berichtete nach einiger Zeit dass er die Hähnchen mit Knochen die auf dem GG abgebildet sind, gespürt habe als hätte er sie persönlich verdaut. Nach dieser wunderbaren Erfahrung hat er keine stressbedingten Magenprobleme mehr.</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:7s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="5ebdb738-5a84-4532-a2d6-8e69d6b36d8f" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="40f87e6d-0a7e-4149-898a-fcd90bf97fa9" data-position="1" data-parent-id="bb3db209-ce4d-446f-8bd1-a3dba8a471b9" data-mode="vertical" data-atom-horizontal="center" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:8px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="custom" style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,179,224;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,179,224],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="custom"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="8m1sv">&quot;In Zeiten in denen ich nicht wusste, warum mir wieder dasselbe passiert, obwohl ich es nicht mehr möchte, konnte ich durch die Qodes meine Verhaltens-und Denkmuster kontinuierliche verändern.&quot;</div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="7eb0i"><br/></div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="3n4ok"><br/></div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="5iik6">
Ingrid</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:8s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="80db1ab0-e196-401c-9f81-a58afa6d2659" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="0efa59db-f3e5-472e-8657-e3c960b1658b" data-position="1" data-parent-id="bb3db209-ce4d-446f-8bd1-a3dba8a471b9" data-mode="vertical" data-atom-horizontal="center" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:8px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="custom" style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,179,224;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,179,224],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="custom"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="8m1sv">Liebe Gertie, Das GertieGan MuschelPuschel hat mir bei meiner Ischilagie supergut geholfen. Ich hatte mir beim Gießkanne anheben einen Hexenschuss zugezogen, der durch ruhe alleine nicht besser wurde. Nach 2 Tagen hole ich mir das GertieGan MuschelPuschel um meine Wirbelkörper wieder zu sortieren und an die richtige Stelle zu bringen. Nach 1 Stunde war der Schmerz verschwunden und nur noch ein leichtes angestrengtes Gefühl in der Region geblieben, das am nächsten Tag verschwunden war. Ein Segen! Alles Liebe Gudrun</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:9s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="0aa4a82d-9e7d-4024-aa9c-c31d3f3368d7" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="0a130f6b-a389-4b61-810c-8f19812841cb" data-position="1" data-parent-id="bb3db209-ce4d-446f-8bd1-a3dba8a471b9" data-mode="vertical" data-atom-horizontal="center" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:8px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="custom" style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,179,224;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,179,224],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="custom"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="8m1sv">Eine Klientin hat Burnout-Symptome und lies sich krankschreiben. Sie klagte über Konzentrationsschwäche und Zitat: &quot;wuselig im Kopf &quot; Sie hätte keine Klarheit und keinen Focus mehr. Daraufhin empfahl ich Ihr das GG Graf Tatterfit und es stellte sich sofort Besserung ein. Jetzt ist Sie wieder Fröhlich und denkt darüber nach wieder zu arbeiten.</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:10s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="7d78bab1-1264-4fa3-867e-a2442ccfe017" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="8a7d3059-23f1-4b02-9a63-97a41c6ebd59" data-position="1" data-parent-id="bb3db209-ce4d-446f-8bd1-a3dba8a471b9" data-mode="vertical" data-atom-horizontal="center" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:8px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="custom" style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,179,224;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,179,224],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="custom"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="8m1sv">Epilepsiepatientin die in extreme Stress-Situation kommt und massive Aussetzer (Vorstufe die sie spürt vor Anfall) produziert, trotz medikamentöser Notfallmitteln keine Besserung. Mit Fingerstellung und Empfangschefin werden die Aussetzer sofort weniger, unterstützt durch Ruhe sind die Aussetzer bis zum Abend komplett weg. Danke!</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:11s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="612d8c84-f531-4042-90ed-fb3fa44c7915" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="ad0028e5-1df5-4849-995e-13e8dbf86455" data-position="1" data-parent-id="bb3db209-ce4d-446f-8bd1-a3dba8a471b9" data-mode="vertical" data-atom-horizontal="center" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:8px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="custom" style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,179,224;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,179,224],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="custom"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="8m1sv">Ihr Lieben, hier ein Feedback von Peitschenelli: ein 88 jähriger Herr hat bereits wochenlang Blut im Urin. Mal hellrot, mal ganz dunkelblutig. Weil es ihm sehr gut geht und er darüberhinaus keine Beschwerden hat, will er sich nicht untersuchen lassen. Er schaut aber Peitschenelli an und der Urin wird am selben Tag wieder klar und bleibt klar.

Liebesgrüße und große Dankbarkeit an die Autorin Gertie</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:12s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="e4883c68-d7fb-4e30-ab43-85f266f38e6a" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="f8e45e74-a720-4221-87a4-9c80f1149bae" data-position="1" data-parent-id="bb3db209-ce4d-446f-8bd1-a3dba8a471b9" data-mode="vertical" data-atom-horizontal="center" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:8px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="custom" style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,179,224;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,179,224],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="custom"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="8m1sv">Seit einigen Tagen habe ich keine Schwindelgefühle mehr und ich fühle mich insgesamt gut bei Kräften – auch im Kopf… Das BoosterGan liegt weiterhin auf meinem Schreibtisch, so dass immer wieder mein Blick darauf fällt. Besten Dank für deine Hilfe</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:13s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="9bb6bb6b-98b5-44ee-b96c-577d0f91768e" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="e93ae6d4-da10-47dd-a73a-15e74d18a63e" data-position="1" data-parent-id="bb3db209-ce4d-446f-8bd1-a3dba8a471b9" data-mode="vertical" data-atom-horizontal="center" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:8px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="custom" style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,179,224;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,179,224],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="custom"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="8m1sv">38-jährige Patientin (Behandlungsbeginn vor ca. 3Wochen) – MS, Schwäche rechtes Bein nach längerem Laufen, dringende Empfehlung um nichts zu verpassen: Krankenhaus zur Cortison-Infusionstherapie für 3-5 Tage, vermutlich akuter MS-Schub. 2 Tage vor Klinikuntersuchung Beginn mit den Superhelden -&gt; Neurologisch keine Auffälligkeiten – wird am gleichen Tag ohne Therapie wieder entlassen ;-))). Die Superhelden haben so gut gearbeitet, da ist jegliche Überredungskunst als Therapeut unnötig! Phänomenal!!! Lieben Dank!</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:14s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="bbf8ceb2-9d4a-4a8a-8e47-e384481452bc" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="da30bffe-1387-4f22-b641-eccb78e4ad88" data-position="1" data-parent-id="bb3db209-ce4d-446f-8bd1-a3dba8a471b9" data-mode="vertical" data-atom-horizontal="center" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:8px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="custom" style="--color-text:1,1,1;--alpha-text:1;--color-bg:255,179,224;--alpha-bg:1;--color-border:255,179,224;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[255,179,224],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="custom"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="8m1sv"> Ich wollte kurz wegen meiner Stimme berichten. Bei dem BoosterGan hatte ich das Gefühl, dass es mir gut tut es anzusehen. Kigibili-Code habe ich auch gemacht. Meine Stimmprobleme sind nicht weg, aber besser.</div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="emifi"><br/></div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="aifi5"><br/></div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="custom" style="--font-kit-size:14;--font-kit-size-max:14;--font-kit-line-height:inherit" data-block-key="et297"><br/></div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div></div></div></div></div></div></div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="row" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-organism-background" aria-hidden="true"><div style="position:relative;overflow:hidden;width:100%;height:100%" class="parallax-banner con-kit-organism-parallax"><div class="parallax-outer" style="position:absolute;top:0;right:0;bottom:0;left:0"><div class="parallax-inner" style="position:absolute;top:0;right:0;bottom:0;left:0"><div class="parallax-banner-layer-0" style="position:absolute;top:0;right:0;bottom:0;left:0"></div></div></div></div></div></div></div><style></style><script type="application/javascript">
