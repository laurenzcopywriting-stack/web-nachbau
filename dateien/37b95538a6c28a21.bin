s":[],"data":{"align_horizontal":"center"}}],"entityMap":{}}},"styles":{"indentLg":20,"font_type":"m","atom_width":100}},{"_id":"d66b67aa-bdd2-4a4d-8b84-68913d5dfe91","position":3,"type":"plain-text","data":{"items":[{"data":{"type":"facebook","link_text":"Facebook","link_href":"","link_blank":false},"styles":{},"_id":"497d0f74-dd27-4bdd-95e5-152991bba467"},{"data":{"type":"instagram","link_text":"Instagram","link_href":"","link_blank":false},"styles":{},"_id":"877e6699-8f27-49c2-b462-ecd1aaa250ce"},{"data":{"type":"youtube","link_text":"Youtube","link_href":"","link_blank":false},"styles":{},"_id":"f82800cd-f4c8-41fb-9ab9-ce04b4abc4df"}],"text":{"blocks":[{"key":"PDNuiUFqBX","text":"Unsere Freebie-Tools haben schon kleine Impulse, Erkenntnisse oder spürbare Veränderungen in deinem Wohlbefinden ausgelöst?","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{"align_horizontal":"center"}},{"key":"1li9c","text":"\rHerzlichen Glückwunsch – du hast einen Funken in dir. ","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{"align_horizontal":"center"}},{"key":"e01lj","text":"\rDieser Funke zeigt: In dir steckt die Fähigkeit, dein Leben in Fülle, Harmonie und Leichtigkeit zu gestalten.","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{"align_horizontal":"center"}}],"entityMap":{}}},"styles":{"font_type":"l","atom_width":100,"indentLg":8}}]},{"_id":"a1605649-c3a8-4c15-9895-0ee312d46ecd","position":2,"styles":{"layout_column":3,"style_type":"transparent","align_horizontal":"left","__temporary_wrap_header_atoms":false},"data":{},"type":"base","moleculeModel":"text-block","children":[],"atoms":[{"_id":"4df910be-d964-4463-9d2d-2e3c91eae05d","position":3,"type":"plain-text","data":{"items":[{"data":{"type":"facebook","link_text":"Facebook","link_href":"","link_blank":false},"styles":{},"_id":"ea81c67a-d243-4390-beb1-8b3ff0d0b9af"},{"data":{"type":"instagram","link_text":"Instagram","link_href":"","link_blank":false},"styles":{},"_id":"4eba2533-f9ea-4100-9b27-d626a8b8212f"},{"data":{"type":"youtube","link_text":"Youtube","link_href":"","link_blank":false},"styles":{},"_id":"103166f7-c6e1-4039-b449-922277641306"}],"text":{"blocks":[{"key":"PDNuiUFqBX","text":"Als Hochsensible fühlte sich mein Alltag voller Blockaden oft erschöpfend an. ","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{"align_horizontal":"center"}},{"key":"2ri6n","text":"Jagd nach Tipps und Tricks im Außen halfen nur oberflächlich, ohne die Wurzel zu lösen.\r","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{"align_horizontal":"center"}},{"key":"5f686","text":"Dann entdeckte ich als Ärztin wie Patientin die Gienow-Tools und erlebte: \r","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{"align_horizontal":"center"}},{"key":"47a24","text":"Durch Schulung meines Bewusstseins kann ich echte Veränderung auslösen ","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{"align_horizontal":"center"}},{"key":"39jh6","text":"– und heilte mich als ganzen Menschen.\r","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{"align_horizontal":"center"}},{"key":"d9815","text":"\r\r","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{"align_horizontal":"center"}}],"entityMap":{}}},"styles":{"font_type":"l","atom_width":100,"indentLg":8}},{"_id":"dcfe716d-2406-4e65-8dab-75c78b15795f","position":2,"type":"header","data":{"items":[{"data":{"type":"facebook","link_text":"Facebook","link_href":"","link_blank":false},"styles":{},"_id":"28488cdb-393f-4cf0-87d4-0d40dbb19210"},{"data":{"type":"instagram","link_text":"Instagram","link_href":"","link_blank":false},"styles":{},"_id":"5145b2d3-04a5-4ed9-9305-af9e910a60c8"},{"data":{"type":"youtube","link_text":"Youtube","link_href":"","link_blank":false},"styles":{},"_id":"52f44c1c-4e00-4a9a-a546-10d436dd16a3"}],"text":{"block