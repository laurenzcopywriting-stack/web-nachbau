arrow_style_type":"transparent","grid_slider_arrow_outside":false,"grid_slider_hanging":false,"grid_slider_arrow_size":"s","grid_slider_arrow_distance_size":"m","grid_slider_arrow_distance_size_custom":24,"grid_slider_arrow_icon_nucleo_config":{"label":"arrow-right","svg":"\u003Cpath data-fill=\"#444444\" d=\"M22.707,11.293L15,3.586L13.586,5l6,6H2c-0.553,0-1,0.448-1,1s0.447,1,1,1h17.586l-6,6L15,20.414 l7.707-7.707C23.098,12.316,23.098,11.684,22.707,11.293z\"\u003E\u003C\u002Fpath\u003E","size":24,"fill":"glyph","line_weight":2},"grid_slider_arrow_icon_type":"nucleo","grid_slider_arrow_radius_key":"100","grid_slider_arrow_radius_custom":100,"grid_slider_arrow_color_text":"inherit","grid_slider_arrow_color_text_type":"auto","grid_slider_arrow_color_text_alpha":1,"grid_slider_arrow_color_text_variation":"text","grid_slider_arrow_color_text_custom":"","grid_slider_arrow_color_bg":"inherit","grid_slider_arrow_color_bg_type":"auto","grid_slider_arrow_color_bg_alpha":1,"grid_slider_arrow_color_bg_variation":"text","grid_slider_arrow_color_bg_custom":"","grid_slider_arrow_color_border":"inherit","grid_slider_arrow_color_border_type":"auto","grid_slider_arrow_color_border_alpha":1,"grid_slider_arrow_color_border_variation":"text","grid_slider_arrow_color_border_custom":"","style_color_text":"inherit","style_color_text_type":"auto","style_color_text_alpha":1,"style_color_text_variation":"text","style_color_text_custom":"","style_color_bg":"inherit","style_color_bg_type":"auto","style_color_bg_alpha":1,"style_color_bg_variation":"harmonic","style_color_bg_custom":"","style_color_border":"inherit","style_color_border_type":"auto","style_color_border_alpha":1,"style_color_border_variation":"harmonic","style_color_border_custom":"","color_bg":"white","color_bg_type":"custom","color_bg_alpha":1,"color_bg_variation":"text","color_bg_custom":"255,179,224","shadow_key":"none","shadow_x":0,"shadow_y":8,"shadow_blur":40,"shadow_spreed":0,"shadow_opacity":0.15,"border_width":"default","border_width_custom":1,"border_type":"solid","color_bg_key":"key1","color_bg_tone":-0.7},"data":[],"type":"grid","moleculeModel":"grid","children":[{"_id":"6dec51ce-4ca0-4f76-9131-b70b54c6ff2f","position":1,"styles":{},"data":{},"type":"child","moleculeModel":"grid","children":[],"atoms":[{"_id":"70426003-5ebb-4174-bcff-4ca90b1b906d","position":1,"type":"plain-text","parentId":"bb3db209-ce4d-446f-8bd1-a3dba8a471b9","data":{"text":{"blocks":[{"key":"MbFOB4YsTg","text":"Eine Frau leidet unter einem Speicheldrüsenlrebs, der nicht operiert werden konnte. ","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{"align_horizontal":"center"}},{"key":"f1lb2","text":"Durch Arbeit mit Qodes und BoosterGane wurde er operabel und ist ausgeheilt.","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{"align_horizontal":"center"}},{"key":"4pst5","text":"","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}},{"key":"8jvaa","text":"","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}},{"key":"6beqb","text":"","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}}],"entityMap":{}},"items":[]},"styles":{}}]},{"_id":"661f22d3-e9c4-4132-b0dd-3202cb99d542","position":2,"styles":{},"data":{},"type":"child","moleculeModel":"grid","children":[],"atoms":[{"_id":"add3564e-3750-49c4-b8a8-8be035bd70b8","position":1,"type":"plain-text","parentId":"bb3db209-ce4d-446f-8bd1-a3dba8a471b9","data":{"text":{"blocks":[{"key":"8m1sv","text":"Litt an schwerster Neurodermitis, einem Aneurysma im Kopf sowie an ständiger Angst und Überarbeitung. Heute ist sie wie erblüht: selbstbewusst, fröhlich und frei. Sie gestaltet ihr Leben aktiv, meistert selbst größte Herausforderungen spielerisch und verfügt mit der GienowMethode über ein DIY-Gesundheitssystem, das ihr kontinuierliches Wachstum und ihre Gesundheit unterstützt.","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}},{"key":"1s390","text":"\r\n- Christiane B.","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}}],"entityMap":{}},"items":[]},"styles":{}}]},{"_id":"855a05de-22d0-4f7c-a44c-870712628fb5","position":3,"styles":{},"data":{},"type":"child","moleculeModel":"grid","children":[],"atoms":[{"_id":"cf85f531-eea4-4092-a7ec-d86ffea414a7","position":1,"type":"plain-text","parentId":"bb3db209-ce4d-446f-8bd1-a3dba8a471b9","data":{"text":{"blocks":[{"key":"8m1sv","text":"Beim Training erlitt eine Klientin einen Hexenschuss.\r\nFrüher hatte sie oft Bandscheibenprobleme, seit der GienowMethode jedoch nicht mehr.\r\nErst nahm sie aus Gewohnheit ein Schmerzmittel, dann erinnerte sie sich an die Fingergeste für Hexenschuss.\r\n\r\n\"Gudrun, du glaubst es nicht: Sofort waren die Schmerzen um 90% besser und am Abend ganz weg.\"","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}}],"entityMap":{}},"items":[]},"styles":{}}]},{"_id":"5a7ec338-7eaf-41da-b401-3bcac7b9fafd","position":4,"styles":{},"data":{},"type":"child","moleculeModel":"grid","children":[],"atoms":[{"_id":"c3415ecb-1927-4ec8-b5f9-fe8434d2613d","position":1,"type":"plain-text","parentId":"bb3db209-ce4d-446f-8bd1-a3dba8a471b9","data":{"text":{"blocks":[{"key":"8m1sv","text":"Ein Patient hat ein Jahr lang den Nachtfalter immer mal wieder angesehen und hatte das ganze Jahr keine von seinen ewigen Infekten mit chronischer Sinusitis. ","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}},{"key":"53m10","text":"Er ist völlig begeistert. In einer neuen Verarbeitungsebene mit seinen seelisch belastenden Prozessen in einer Umgebung taucht nun die Sinusitis wieder auf mit Herzbeschwerden. Nun gesellt sich GammaEi als GertieGan dazu.","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}}],"entityMap":{}},"items":[]},"styles":{}}]},{"_id":"7b91fe84-cd1c-4de0-a93b-763d6407293f","position":5,"styles":{},"data":{},"type":"child","moleculeModel":"grid","children":[],"atoms":[{"_id":"32bae729-f148-4b02-ac32-701b1bbd3dd0","position":1,"type":"plain-text","parentId":"bb3db209-ce4d-446f-8bd1-a3dba8a471b9","data":{"text":{"blocks":[{"key":"8m1sv","text":"GG Super Mario Magen: Einen Klienten habe ich Super Mario Magen empfohlen, er sagte das sich jedes Problem immer auf seinen Magen schlägt und das war schon immer so. Er arbeitete intensiv mit GG Super Mario Magen und berichtete nach einiger Zeit dass er die Hähnchen mit Knochen die auf dem GG abgebildet sind, gespürt habe als hätte er sie persönlich verdaut. Nach dieser wunderbaren Erfahrung hat er keine stressbedingten Magenprobleme mehr.","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}}],"entityMap":{}},"items":[]},"styles":{}}]},{"_id":"80db1ab0-e196-401c-9f81-a58afa6d2659","position":6,"styles":{},"data":{},"type":"child","moleculeModel":"grid","children":[],"atoms":[{"_id":"0efa59db-f3e5-472e-8657-e3c960b1658b","position":1,"type":"plain-text","parentId":"bb3db209-ce4d-446f-8bd1-a3dba8a471b9","data":{"text":{"blocks":[{"key":"8m1sv","text":"Liebe Gertie, Das GertieGan MuschelPuschel hat mir bei meiner Ischilagie supergut geholfen. Ich hatte mir beim Gießkanne anheben einen Hexenschuss zugezogen, der durch ruhe alleine nicht besser wurde. Nach 2 Tagen hole ich mir das GertieGan MuschelPuschel um meine Wirbelkörper wieder zu sortieren und an die richtige Stelle zu bringen. Nach 1 Stunde war der Schmerz verschwunden und nur noch ein leichtes angestrengtes Gefühl in der Region geblieben, das am nächsten Tag verschwunden war. Ein Segen! Alles Liebe Gudrun","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}}],"entityMap":{}},"items":[]},"styles":{}}]},{"_id":"0aa4a82d-9e7d-4024-aa9c-c31d3f3368d7","position":7,"styles":{},"data":{},"type":"child","moleculeModel":"grid","children":[],"atoms":[{"_id":"0a130f6b-a389-4b61-810c-8f19812841cb","position":1,"type":"plain-text","parentId":"bb3db209-ce4d-446f-8bd1-a3dba8a471b9","data":{"text":{"blocks":[{"key":"8m1sv","text":"Eine Klientin hat Burnout-Symptome und lies sich krankschreiben. Sie klagte über Konzentrationsschwäche und Zitat: \"wuselig im Kopf \" Sie hätte keine Klarheit und keinen Focus mehr. Daraufhin empfahl ich Ihr das GG Graf Tatterfit und es stellte sich sofort Besserung ein. Jetzt ist Sie wieder Fröhlich und denkt darüber nach wieder zu arbeiten.","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}}],"entityMap":{}},"items":[]},"styles":{}}]},{"_id":"7d78bab1-1264-4fa3-867e-a2442ccfe017","position":8,"styles":{},"data":{},"type":"child","moleculeModel":"grid","children":[],"atoms":[{"_id":"8a7d3059-23f1-4b02-9a63-97a41c6ebd59","position":1,"type":"plain-text","parentId":"bb3db209-ce4d-446f-8bd1-a3dba8a471b9","data":{"text":{"blocks":[{"key":"8m1sv","text":"Epilepsiepatientin die in extreme Stress-Situation kommt und massive Aussetzer (Vorstufe die sie spürt vor Anfall) produziert, trotz medikamentöser Notfallmitteln keine Besserung. Mit Fingerstellung und Empfangschefin werden die Aussetzer sofort weniger, unterstützt durch Ruhe sind die Aussetzer bis zum Abend komplett weg. Danke!","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}}],"entityMap":{}},"items":[]},"styles":{}}]},{"_id":"612d8c84-f531-4042-90ed-fb3fa44c7915","position":9,"styles":{},"data":{},"type":"child","moleculeModel":"grid","children":[],"atoms":[{"_id":"ad0028e5-1df5-4849-995e-13e8dbf86455","position":1,"type":"plain-text","parentId":"bb3db209-ce4d-446f-8bd1-a3dba8a471b9","data":{"text":{"blocks":[{"key":"8m1sv","text":"Ihr Lieben, hier ein Feedback von Peitschenelli: ein 88 jähriger Herr hat bereits wochenlang Blut im Urin. Mal hellrot, mal ganz dunkelblutig. Weil es ihm sehr gut geht und er darüberhinaus keine Beschwerden hat, will er sich nicht untersuchen lassen. Er schaut aber Peitschenelli an und der Urin wird am selben Tag wieder klar und bleibt klar.\r\n\r\nLiebesgrüße und große Dankbarkeit an die Autorin Gertie","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}}],"entityMap":{}},"items":[]},"styles":{}}]},{"_id":"e4883c68-d7fb-4e30-ab43-85f266f38e6a","position":10,"styles":{},"data":{},"type":"child","moleculeModel":"grid","children":[],"atoms":[{"_id":"f8e45e74-a720-4221-87a4-9c80f1149bae","position":1,"type":"plain-text","parentId":"bb3db209-ce4d-446f-8bd1-a3dba8a471b9","data":{"text":{"blocks":[{"key":"8m1sv","text":"Seit einigen Tagen habe ich keine Schwindelgefühle mehr und ich fühle mich insgesamt gut bei Kräften – auch im Kopf… Das BoosterGan liegt weiterhin auf meinem Schreibtisch, so dass immer wieder mein Blick darauf fällt. Besten Dank für deine Hilfe","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}}],"entityMap":{}},"items":[]},"styles":{}}]},{"_id":"9bb6bb6b-98b5-44ee-b96c-577d0f91768e","position":11,"styles":{},"data":{},"type":"child","moleculeModel":"grid","children":[],"atoms":[{"_id":"e93ae6d4-da10-47dd-a73a-15e74d18a63e","position":1,"type":"plain-text","parentId":"bb3db209-ce4d-446f-8bd1-a3dba8a471b9","data":{"text":{"blocks":[{"key":"8m1sv","text":"38-jährige Patientin (Behandlungsbeginn vor ca. 3Wochen) – MS, Schwäche rechtes Bein nach längerem Laufen, dringende Empfehlung um nichts zu verpassen: Krankenhaus zur Cortison-Infusionstherapie für 3-5 Tage, vermutlich akuter MS-Schub. 2 Tage vor Klinikuntersuchung Beginn mit den Superhelden -\u003E Neurologisch keine Auffälligkeiten – wird am gleichen Tag ohne Therapie wieder entlassen ;-))). Die Superhelden haben so gut gearbeitet, da ist jegliche Überredungskunst als Therapeut unnötig! Phänomenal!!! Lieben Dank!","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}}],"entityMap":{}},"items":[]},"styles":{}}]},{"_id":"bbf8ceb2-9d4a-4a8a-8e47-e384481452bc","position":12,"styles":{},"data":{},"type":"child","moleculeModel":"grid","children":[],"atoms":[{"_id":"da30bffe-1387-4f22-b641-eccb78e4ad88","position":1,"type":"plain-text","parentId":"bb3db209-ce4d-446f-8bd1-a3dba8a471b9","data":{"text":{"blocks":[{"key":"8m1sv","text":" Ich wollte kurz wegen meiner Stimme berichten. Bei dem BoosterGan hatte ich das Gefühl, dass es mir gut tut es anzusehen. Kigibili-Code habe ich auch gemacht. Meine Stimmprobleme sind nicht weg, aber besser.","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}},{"key":"emifi","text":"","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}},{"key":"aifi5","text":"","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}},{"key":"et297","text":"","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}}],"entityMap":{}},"items":[]},"styles":{}}]},{"_id":"5fa9df53-a288-490d-ab30-48c85f002c70","type":"child","data":{},"styles":{},"moleculeModel":"grid","position":2,"children":[],"atoms":[{"_id":"d5380ce5-ef91-4fcc-8b88-62caa40fa745","type":"plain-text","parentId":"bb3db209-ce4d-446f-8bd1-a3dba8a471b9","position":1,"data":{"text":{"blocks":[{"key":"8m1sv","text":"Nach der ersten Pilleneinnahme entwickelte eine 16-Jährige starke Nebenwirkungen, darunter einen schmerzhaften Speichelstein. Trotz Cortison, Antibiotika, geplanter OP und Skepsis gegenüber BoosterGane entschied sie sich, abzuwarten. ","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}},{"key":"efkrl","text":"Durch den Steinbeißerbuddha und den passenden Qode löste sich der Stein schließlich von selbst – nach drei Wochen war sie völlig beschwerdefrei und fand mit ihrem Freund eine bessere Alternative zur Pille.","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}}],"entityMap":{}},"items":[]},"styles":{}}]},{"_id":"2b1ef5e5-ff2b-4d36-8a7b-2f7dede3bd94","type":"child","data":{},"styles":{},"moleculeModel":"grid","position":3,"children":[],"atoms":[{"_id":"24119cd9-9233-427b-b37f-723427b34895","type":"plain-text","parentId":"bb3db209-ce4d-446f-8bd1-a3dba8a471b9","position":1,"data":{"text":{"blocks":[{"key":"8m1sv","text":"Ein inoperabler Speicheldrüsenkrebs, der durch die Arbeit mit Qodes und BoosterGane operabel wurde und ausgeheilt ist.\r\n\r\n","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}},{"key":"ev2ak","text":"","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}},{"key":"31apk","text":"","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}},{"key":"3eg2t","text":"Patientin von Dr. Hasler ","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}}],"entityMap":{}},"items":[]},"styles":{}}]},{"_id":"5ebdb738-5a84-4532-a2d6-8e69d6b36d8f","type":"child","data":{},"styles":{},"moleculeModel":"grid","position":5,"children":[],"atoms":[{"_id":"40f87e6d-0a7e-4149-898a-fcd90bf97fa9","type":"plain-text","parentId":"bb3db209-ce4d-446f-8bd1-a3dba8a471b9","position":1,"data":{"text":{"blocks":[{"key":"8m1sv","text":"\"In Zeiten in denen ich nicht wusste, warum mir wieder dasselbe passiert, obwohl ich es nicht mehr möchte, konnte ich durch die Qodes meine Verhaltens-und Denkmuster kontinuierliche verändern.\"","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}},{"key":"7eb0i","text":"","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}},{"key":"3n4ok","text":"","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}},{"key":"5iik6","text":"\r\nIngrid","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}}],"entityMap":{}},"items":[]},"styles":{}}]}],"atoms":[{"_id":"bb3db209-ce4d-446f-8bd1-a3dba8a471b9","position":1,"type":"plain-text","data":{"text":{"blocks":[{"key":"8m1sv","text":"Die große Überschrift","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}}],"entityMap":{}},"items":[]},"styles":{"font_type":"custom","indentLg"