-last con-kit-col--first" data-col-lg="24" data-col-md="24" data-col-sm="24"><div data-id="2e473ea4-24c8-428a-be42-fc0aebbdaccc" data-molecule="grid" style="width:100%"><div class="con-kit-component-marquee" style="--marquee-speed:0s;overflow-x:hidden"><div class="con-kit-component-marquee__content"><div class="con-kit-component-marquee-grid con-kit-component-marquee-grid--columns-3" style="--one-kit-image-height:200px"><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:0s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="67812a98-4fff-4ced-9df8-008892f1a464" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="7c5cf3a0-6555-4866-ba43-eab05a062ea8" data-position="1" data-parent-id="a999a13b-58d2-4ed5-b185-53aa103076b6" data-mode="vertical" data-atom-horizontal="left" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:16px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="m" style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:250,177,177;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[250,177,177],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="m"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="MbFOB4YsTg">&quot;Die hier beschriebenen Hilfe zur Selbsthilfe mit Fingergesten funktioniert einfach hervorragend. Die Fingerapotheke begleitet mich in allen Lebenslagen und entspannt jeden Schmerz und jedes Problem. Unfassbar wie einfach der Zugang zu unseren eigenen Selbstheilungskräften sein kann! Wir müssen es nur tun. Und wie, das steht in diesem Büchlein.&quot;

- Kundenrezension auf Amazon.de </div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:1s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="36a629e1-b300-4fb4-9210-7c5c9e0355e6" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="c5ad3ff4-b71f-45fc-8b14-506e7a85f5e2" data-position="1" data-parent-id="a999a13b-58d2-4ed5-b185-53aa103076b6" data-mode="vertical" data-atom-horizontal="left" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:16px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="m" style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:250,177,177;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[250,177,177],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="m"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="8m1sv">&quot;Egal, ob es sich um leichte Symptome wie eine <span data-inline-style="bold" style="font-weight:bold">Schniefnase oder um schwerwiegende Krankheiten </span>handelte, stets erfuhr ich <span data-inline-style="bold" style="font-weight:bold">Erleichterung </span>(...) Und so <span data-inline-style="bold" style="font-weight:bold">verschwanden über die Jahre </span>auch meine chronische Sinusitis und diverse andere Rücken-, Hüft- und Knieprobleme.&quot;</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:2s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="7af1251a-ddef-4267-9bad-64c3274a9b9f" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="3410596c-442e-4ef1-951a-90d3489353c1" data-position="1" data-parent-id="a999a13b-58d2-4ed5-b185-53aa103076b6" data-mode="vertical" data-atom-horizontal="left" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:16px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="m" style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:250,177,177;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[250,177,177],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="m"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="8m1sv">&quot;Durch Fingergesten sind meine Zähne stärker und gesünder geworden. Eine Außenstehende sagte mir einen Tag nach der Fingergeste meine Zähne seinen viel strahlender als sonst - und sie wusste nichts von den Gesten.&quot;</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:3s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="da8f2cab-ef7d-43d2-9cd8-7ed0fd7d0899" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="ed459221-f709-4c94-888f-0b1f58beec72" data-position="1" data-parent-id="a999a13b-58d2-4ed5-b185-53aa103076b6" data-mode="vertical" data-atom-horizontal="left" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:16px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="m" style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:250,177,177;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[250,177,177],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="m"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="8m1sv">Sehr einfache Fingerstellungen aus uraltem Wissen, die ich direkt anwenden konnte und die meinen Energiefluss spürbar harmonisiert haben – so konnte ich körperliche und innere Themen gezielter bearbeiten und auflösen.</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:4s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="0b6dbbdb-2f77-4825-8c06-c1f6281c9e7e" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="fa529114-f365-4cdc-abf3-07d2cd2245e5" data-position="1" data-parent-id="a999a13b-58d2-4ed5-b185-53aa103076b6" data-mode="vertical" data-atom-horizontal="left" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:16px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="m" style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:250,177,177;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[250,177,177],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="m"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="8m1sv">&quot;Ein wertvoller Alltagsbegleiter, der mir hilft, meinen Alltag in bessere Energie lenken zu können. Ich konnte damit helfen, die schriftliche Prüfung meiner Tochter so zu unterstützen, dass sie sich während der Prüfung sicherer fühlte und die Prüfung bestand. Auch meinem Sohn konnte ich damit helfen, als er die praktische Fahrprüfung machte.&quot;
</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:5s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="0110c2f3-c9dc-4e1c-983c-2e96d98ed54d" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="f188b52e-4e7c-4c24-8c56-36bb5537c730" data-position="1" data-parent-id="a999a13b-58d2-4ed5-b185-53aa103076b6" data-mode="vertical" data-atom-horizontal="left" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:16px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="m" style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:250,177,177;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[250,177,177],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="m"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="8m1sv">Beim Training erlitt eine Klientin einen Hexenschuss.
Früher hatte sie oft Bandscheibenprobleme, seit der GienowMethode jedoch nicht mehr.</div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="1h9h4">Erst nahm sie aus Gewohnheit ein Schmerzmittel, dann erinnerte sie sich an die Fingergeste für Hexenschuss.</div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="4mrc8">&quot;Gudrun, du glaubst es nicht: Sofort waren die Schmerzen um 90% besser und am Abend ganz weg.&quot;
</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:6s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="4b93471b-9166-4110-b826-5c7f5b243e04" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="cff84c9c-8576-481a-9086-fb6ed4a04835" data-position="1" data-parent-id="a999a13b-58d2-4ed5-b185-53aa103076b6" data-mode="vertical" data-atom-horizontal="left" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:16px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="m" style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:250,177,177;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[250,177,177],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="m"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="8m1sv">Ich bin am Wochenende nachts durch das Kribbeln einer sich ankündigenden Lippenherpes aufgewacht. Hab es dann gleich in mein Gesundheitskonto hochgeladen und die Fingergeste für Lippenherpes gehalten. Daraufhin konnte ich wieder einschlafen und am nächsten Tag verschwand das Lippenbläschen wieder</div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="8vu8e">- Georg P.</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:7s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="95473933-f0df-426f-9e9d-4e459e9e32cb" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="1f84faea-d365-4ac6-b5dd-f7b417128d08" data-position="1" data-parent-id="a999a13b-58d2-4ed5-b185-53aa103076b6" data-mode="vertical" data-atom-horizontal="left" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:16px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="m" style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:250,177,177;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[250,177,177],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="m"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="8m1sv">Ich bin ein großer Fan der Fingergesten, der Fingerapotheke, die ich häufig anwende und an Freunde und Familie weiter gegeben habe.
</div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="8vu8e">- Sigrun</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div></div><div class="con-kit-component-marquee__repeat" style="transform:translateX(100%);width:0px"><div class="con-kit-component-marquee-grid con-kit-component-marquee-grid--columns-3" style="--one-kit-image-height:200px"><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:0s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="67812a98-4fff-4ced-9df8-008892f1a464" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="7c5cf3a0-6555-4866-ba43-eab05a062ea8" data-position="1" data-parent-id="a999a13b-58d2-4ed5-b185-53aa103076b6" data-mode="vertical" data-atom-horizontal="left" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:16px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="m" style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:250,177,177;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[250,177,177],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="m"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="MbFOB4YsTg">&quot;Die hier beschriebenen Hilfe zur Selbsthilfe mit Fingergesten funktioniert einfach hervorragend. Die Fingerapotheke begleitet mich in allen Lebenslagen und entspannt jeden Schmerz und jedes Problem. Unfassbar wie einfach der Zugang zu unseren eigenen Selbstheilungskräften sein kann! Wir müssen es nur tun. Und wie, das steht in diesem Büchlein.&quot;

- Kundenrezension auf Amazon.de </div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:1s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="36a629e1-b300-4fb4-9210-7c5c9e0355e6" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="c5ad3ff4-b71f-45fc-8b14-506e7a85f5e2" data-position="1" data-parent-id="a999a13b-58d2-4ed5-b185-53aa103076b6" data-mode="vertical" data-atom-horizontal="left" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:16px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="m" style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:250,177,177;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[250,177,177],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="m"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="8m1sv">&quot;Egal, ob es sich um leichte Symptome wie eine <span data-inline-style="bold" style="font-weight:bold">Schniefnase oder um schwerwiegende Krankheiten </span>handelte, stets erfuhr ich <span data-inline-style="bold" style="font-weight:bold">Erleichterung </span>(...) Und so <span data-inline-style="bold" style="font-weight:bold">verschwanden über die Jahre </span>auch meine chronische Sinusitis und diverse andere Rücken-, Hüft- und Knieprobleme.&quot;</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:2s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="7af1251a-ddef-4267-9bad-64c3274a9b9f" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="3410596c-442e-4ef1-951a-90d3489353c1" data-position="1" data-parent-id="a999a13b-58d2-4ed5-b185-53aa103076b6" data-mode="vertical" data-atom-horizontal="left" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:16px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="m" style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:250,177,177;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[250,177,177],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="m"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="8m1sv">&quot;Durch Fingergesten sind meine Zähne stärker und gesünder geworden. Eine Außenstehende sagte mir einen Tag nach der Fingergeste meine Zähne seinen viel strahlender als sonst - und sie wusste nichts von den Gesten.&quot;</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:3s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="da8f2cab-ef7d-43d2-9cd8-7ed0fd7d0899" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="ed459221-f709-4c94-888f-0b1f58beec72" data-position="1" data-parent-id="a999a13b-58d2-4ed5-b185-53aa103076b6" data-mode="vertical" data-atom-horizontal="left" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:16px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="m" style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:250,177,177;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[250,177,177],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="m"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="8m1sv">Sehr einfache Fingerstellungen aus uraltem Wissen, die ich direkt anwenden konnte und die meinen Energiefluss spürbar harmonisiert haben – so konnte ich körperliche und innere Themen gezielter bearbeiten und auflösen.</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:4s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="0b6dbbdb-2f77-4825-8c06-c1f6281c9e7e" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="fa529114-f365-4cdc-abf3-07d2cd2245e5" data-position="1" data-parent-id="a999a13b-58d2-4ed5-b185-53aa103076b6" data-mode="vertical" data-atom-horizontal="left" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:16px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="m" style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:250,177,177;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[250,177,177],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="m"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="8m1sv">&quot;Ein wertvoller Alltagsbegleiter, der mir hilft, meinen Alltag in bessere Energie lenken zu können. Ich konnte damit helfen, die schriftliche Prüfung meiner Tochter so zu unterstützen, dass sie sich während der Prüfung sicherer fühlte und die Prüfung bestand. Auch meinem Sohn konnte ich damit helfen, als er die praktische Fahrprüfung machte.&quot;
</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:5s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="0110c2f3-c9dc-4e1c-983c-2e96d98ed54d" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="f188b52e-4e7c-4c24-8c56-36bb5537c730" data-position="1" data-parent-id="a999a13b-58d2-4ed5-b185-53aa103076b6" data-mode="vertical" data-atom-horizontal="left" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:16px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="m" style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:250,177,177;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[250,177,177],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="m"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="8m1sv">Beim Training erlitt eine Klientin einen Hexenschuss.
Früher hatte sie oft Bandscheibenprobleme, seit der GienowMethode jedoch nicht mehr.</div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="1h9h4">Erst nahm sie aus Gewohnheit ein Schmerzmittel, dann erinnerte sie sich an die Fingergeste für Hexenschuss.</div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="4mrc8">&quot;Gudrun, du glaubst es nicht: Sofort waren die Schmerzen um 90% besser und am Abend ganz weg.&quot;
</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:6s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="4b93471b-9166-4110-b826-5c7f5b243e04" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="cff84c9c-8576-481a-9086-fb6ed4a04835" data-position="1" data-parent-id="a999a13b-58d2-4ed5-b185-53aa103076b6" data-mode="vertical" data-atom-horizontal="left" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:16px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="m" style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:250,177,177;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[250,177,177],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="m"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="8m1sv">Ich bin am Wochenende nachts durch das Kribbeln einer sich ankündigenden Lippenherpes aufgewacht. Hab es dann gleich in mein Gesundheitskonto hochgeladen und die Fingergeste für Lippenherpes gehalten. Daraufhin konnte ich wieder einschlafen und am nächsten Tag verschwand das Lippenbläschen wieder</div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="8vu8e">- Georg P.</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-component-marquee-grid-item con-kit-animation__grid_item" style="--one-kit-component-grid-list-horizontal-space:24px;--one-kit-animation-item-delay:7s"><div style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:255,255,255;--alpha-border:1;--one-kit-radius:8px;--one-kit-padding:32px" class="con-kit-molecule-grid-item" data-kit-radius="8" data-child-id="95473933-f0df-426f-9e9d-4e459e9e32cb" data-kit-align-horizontal="left" data-kit-align-vertical="top" data-kit-frame="solid" data-kit-has-fixed="false"><div class="con-kit-component-atom-list" style="height:100%"><div data-atom="plain-text" data-id="1f84faea-d365-4ac6-b5dd-f7b417128d08" data-position="1" data-parent-id="a999a13b-58d2-4ed5-b185-53aa103076b6" data-mode="vertical" data-atom-horizontal="left" data-atom-vertical="top" class="con-kit-animation__atom" style="--a-indent-lg:16px;--a-width:100%;--one-kit-animation-item-delay:1s"><div class="con-kit-atom-plain-text" data-font-kit-type="m" style="--color-text:1,1,1;--alpha-text:1;--color-bg:250,177,177;--alpha-bg:1;--color-border:250,177,177;--alpha-border:1"><div class="con-kit-atom__effects" data-parent-color-ctx="{&quot;colorBg&quot;:&quot;__custom&quot;,&quot;colorBgType&quot;:&quot;custom&quot;,&quot;colorBgAlpha&quot;:1,&quot;colorBgFormat&quot;:[250,177,177],&quot;colorBgVariant&quot;:&quot;__custom&quot;,&quot;colorText&quot;:&quot;__custom&quot;,&quot;colorTextType&quot;:&quot;auto&quot;,&quot;colorTextAlpha&quot;:1,&quot;colorTextFormat&quot;:[1,1,1],&quot;colorTextVariant&quot;:&quot;__custom&quot;}"></div><div class="con-kit-component-text" data-text-prop="text" data-font-kit-type="m"><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="8m1sv">Ich bin ein großer Fan der Fingergesten, der Fingerapotheke, die ich häufig anwende und an Freunde und Familie weiter gegeben habe.
</div><div class="con-kit-quark con-kit-quark-paragraph" data-quark="block" data-font-kit-type="m" data-block-key="8vu8e">- Sigrun</div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="atom" class="con-kit-component-spacer__handler"></div></div></div></div></div></div></div></div></div></div></div></div></div></div><div class="con-kit-component-spacer" style="pointer-events:none" aria-hidden="true"><div data-spacer-type="row" class="con-kit-component-spacer__handler"></div></div></div></div></div></div><div class="con-kit-organism-background" aria-hidden="true"><div style="position:relative;overflow:hidden;width:100%;height:100%" class="parallax-banner con-kit-organism-parallax"><div class="parallax-outer" style="position:absolute;top:0;right:0;bottom:0;left:0"><div class="parallax-inner" style="position:absolute;top:0;right:0;bottom:0;left:0"><div class="parallax-banner-layer-0" style="position:absolute;top:0;right:0;bottom:0;left:0"></div></div></div></div></div></div></div><style></style><script type="application/javascript">
