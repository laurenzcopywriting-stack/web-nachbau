"_id":"c1a13fb3-10ab-49f6-bc89-5831e9410248","layout":"l11a","title":"Grid","data":{},"styles":{"align_horizontal":"center","align_vertical":"middle","color_bg":"light","padding_top":50,"padding_bottom":50,"padding_key":"xl","media_type":"image","background_type":"color","color_text_type":"auto","color_text":"black","padding_custom":100,"container_style_type":"transparent","animation_type":"off","animation_duration":600,"animation_element":true,"animation_timing":"ease-out","color_bg_type":"palette","container_radius_key":"4","container_padding_key":"custom","container_color_bg_variation":"harmonic","container_color_bg_type":"palette","container_color_bg":"white","full_height":false,"container_padding_custom":80,"bg_image_src":"","overlay_type":"gradient","overlay_gradient_color1":"black","overlay_gradient_opacity1":100,"overlay_gradient_color2":"dark","overlay_gradient_opacity2":55,"overlay_solid_opacity":80,"container_width_key":"1400","color_bg_key":"white","color_bg_tone":0},"position":3,"type":"default","layer":{"_id":"6ff6cabd-b8cd-4845-b05b-edf1ed536de8","type":"flex","data":{},"styles":{},"frames":[{"_id":"f5ba277f-8b5e-4dcd-a96f-814be5aff2e9","position":1,"type":"default","data":{},"styles":{},"rows":[{"_id":"68d438b4-85e9-417a-ba61-314897a20202","data":{},"styles":{},"position":1,"molecules":[{"_id":"2e473ea4-24c8-428a-be42-fc0aebbdaccc","position":1,"styles":{"style_type":"solid","layout_column":24,"fixed_switch":false,"radius_key":"8","radius_custom":4,"grid_type":"marquee","grid_space_key":"s","grid_horizontal_space":24,"grid_vertical_space":24,"grid_columns":3,"gird_masonry_horizontal_size":200,"align_horizontal":"left","align_vertical":"top","padding_key":"m","padding_custom":48,"grid_slider_loop":true,"grid_slider_auto_play":"off","grid_slider_pagination_type":"dots","grid_slider_pagination_size":"l","grid_slider_pagination_outside":false,"grid_slider_pagination_distance_size":"s","grid_slider_pagination_distance_size_custom":8,"grid_slider_pagination_dots_wide":false,"grid_slider_pagination_color_text":"inherit","grid_slider_pagination_color_text_type":"auto","grid_slider_pagination_color_text_alpha":1,"grid_slider_pagination_color_text_variation":"text","grid_slider_pagination_color_text_custom":"","grid_slider_pagination_color_bg":"inherit","grid_slider_pagination_color_bg_type":"auto","grid_slider_pagination_color_bg_alpha":1,"grid_slider_pagination_color_bg_variation":"text","grid_slider_pagination_color_bg_custom":"","grid_slider_pagination_color_border":"inherit","grid_slider_pagination_color_border_type":"auto","grid_slider_pagination_color_border_alpha":1,"grid_slider_pagination_color_border_variation":"text","grid_slider_pagination_color_border_custom":"","grid_slider_pagination_radius_key":"0","grid_slider_pagination_radius_custom":0,"grid_slider_arrow_style_type":"transparent","grid_slider_arrow_outside":false,"grid_slider_hanging":false,"grid_slider_arrow_size":"s","grid_slider_arrow_distance_size":"m","grid_slider_arrow_distance_size_custom":24,"grid_slider_arrow_icon_nucleo_config":{"label":"arrow-right","svg":"\u003Cpath data-fill=\"#444444\" d=\"M22.707,11.293L15,3.586L13.586,5l6,6H2c-0.553,0-1,0.448-1,1s0.447,1,1,1h17.586l-6,6L15,20.414 l7.707-7.707C23.098,12.316,23.098,11.684,22.707,11.293z\"\u003E\u003C\u002Fpath\u003E","size":24,"fill":"glyph","line_weight":2},"grid_slider_arrow_icon_type":"nucleo","grid_slider_arrow_radius_key":"100","grid_slider_arrow_radius_custom":100,"grid_slider_arrow_color_text":"inherit","grid_slider_arrow_color_text_type":"auto","grid_slider_arrow_color_text_alpha":1,"grid_slider_arrow_color_text_variation":"text","grid_slider_arrow_color_text_custom":"","grid_slider_arrow_color_bg":"inherit","grid_slider_arrow_color_bg_type":"auto","grid_slider_arrow_color_bg_alpha":1,"grid_slider_arrow_color_bg_variation":"text","grid_slider_arrow_color_bg_custom":"","grid_slider_arrow_color_border":"inherit","grid_slider_arrow_color_border_type":"auto","grid_slider_arrow_color_border_alpha":1,"grid_slider_arrow_color_border_variation":"text","grid_slider_arrow_color_border_custom":"","style_color_text":"inherit","style_color_text_type":"auto","style_color_text_alpha":1,"style_color_text_variation":"text","style_color_text_custom":"","style_color_bg":"inherit","style_color_bg_type":"auto","style_color_bg_alpha":1,"style_color_bg_variation":"harmonic","style_color_bg_custom":"","style_color_border":"inherit","style_color_border_type":"auto","style_color_border_alpha":1,"style_color_border_variation":"harmonic","style_color_border_custom":"","color_bg":"white","color_bg_type":"custom","color_bg_alpha":1,"color_bg_variation":"text","color_bg_custom":"250,177,177","shadow_key":"none","shadow_x":0,"shadow_y":8,"shadow_blur":40,"shadow_spreed":0,"shadow_opacity":0.15,"border_width":"default","border_width_custom":1,"border_type":"solid"},"data":[],"type":"grid","moleculeModel":"grid","children":[{"_id":"67812a98-4fff-4ced-9df8-008892f1a464","position":1,"styles":{},"data":{},"type":"child","moleculeModel":"grid","children":[],"atoms":[{"_id":"7c5cf3a0-6555-4866-ba43-eab05a062ea8","position":2,"type":"plain-text","parentId":"a999a13b-58d2-4ed5-b185-53aa103076b6","data":{"text":{"blocks":[{"key":"MbFOB4YsTg","text":"\"Die hier beschriebenen Hilfe zur Selbsthilfe mit Fingergesten funktioniert einfach hervorragend. Die Fingerapotheke begleitet mich in allen Lebenslagen und entspannt jeden Schmerz und jedes Problem. Unfassbar wie einfach der Zugang zu unseren eigenen Selbstheilungskräften sein kann! Wir müssen es nur tun. Und wie, das steht in diesem Büchlein.\"\n\n- Kundenrezension auf Amazon.de ","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}}],"entityMap":{}},"items":[]},"styles":{}}]},{"_id":"36a629e1-b300-4fb4-9210-7c5c9e0355e6","position":2,"styles":{},"data":{},"type":"child","moleculeModel":"grid","children":[],"atoms":[{"_id":"c5ad3ff4-b71f-45fc-8b14-506e7a85f5e2","position":2,"type":"plain-text","parentId":"a999a13b-58d2-4ed5-b185-53aa103076b6","data":{"text":{"blocks":[{"key":"8m1sv","text":"\"Egal, ob es sich um leichte Symptome wie eine Schniefnase oder um schwerwiegende Krankheiten handelte, stets erfuhr ich Erleichterung (...) Und so verschwanden über die Jahre auch meine chronische Sinusitis und diverse andere Rücken-, Hüft- und Knieprobleme.\"","type":"unstyled","depth":0,"inlineStyleRanges":[{"offset":47,"length":47,"style":"BOLD"},{"offset":121,"length":14,"style":"BOLD"},{"offset":148,"length":28,"style":"BOLD"}],"entityRanges":[],"data":{}}],"entityMap":{}},"items":[]},"styles":{}}]},{"_id":"7af1251a-ddef-4267-9bad-64c3274a9b9f","position":3,"styles":{},"data":{},"type":"child","moleculeModel":"grid","children":[],"atoms":[{"_id":"3410596c-442e-4ef1-951a-90d3489353c1","position":2,"type":"plain-text","parentId":"a999a13b-58d2-4ed5-b185-53aa103076b6","data":{"text":{"blocks":[{"key":"8m1sv","text":"\"Durch Fingergesten sind meine Zähne stärker und gesünder geworden. Eine Außenstehende sagte mir einen Tag nach der Fingergeste meine Zähne seinen viel strahlender als sonst - und sie wusste nichts von den Gesten.\"","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}}],"entityMap":{}},"items":[]},"styles":{}}]},{"_id":"da8f2cab-ef7d-43d2-9cd8-7ed0fd7d0899","position":4,"styles":{},"data":{},"type":"child","moleculeModel":"grid","children":[],"atoms":[{"_id":"ed459221-f709-4c94-888f-0b1f58beec72","position":2,"type":"plain-text","parentId":"a999a13b-58d2-4ed5-b185-53aa103076b6","data":{"text":{"blocks":[{"key":"8m1sv","text":"Sehr einfache Fingerstellungen aus uraltem Wissen, die ich direkt anwenden konnte und die meinen Energiefluss spürbar harmonisiert haben – so konnte ich körperliche und innere Themen gezielter bearbeiten und auflösen.\r","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}}],"entityMap":{}},"items":[]},"styles":{}}]},{"_id":"0b6dbbdb-2f77-4825-8c06-c1f6281c9e7e","position":5,"styles":{},"data":{},"type":"child","moleculeModel":"grid","children":[],"atoms":[{"_id":"fa529114-f365-4cdc-abf3-07d2cd2245e5","position":2,"type":"plain-text","parentId":"a999a13b-58d2-4ed5-b185-53aa103076b6","data":{"text":{"blocks":[{"key":"8m1sv","text":"\"Ein wertvoller Alltagsbegleiter, der mir hilft, meinen Alltag in bessere Energie lenken zu können. Ich konnte damit helfen, die schriftliche Prüfung meiner Tochter so zu unterstützen, dass sie sich während der Prüfung sicherer fühlte und die Prüfung bestand. Auch meinem Sohn konnte ich damit helfen, als er die praktische Fahrprüfung machte.\"\r\n","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}}],"entityMap":{}},"items":[]},"styles":{}}]},{"_id":"0110c2f3-c9dc-4e1c-983c-2e96d98ed54d","position":6,"styles":{},"data":{},"type":"child","moleculeModel":"grid","children":[],"atoms":[{"_id":"f188b52e-4e7c-4c24-8c56-36bb5537c730","position":2,"type":"plain-text","parentId":"a999a13b-58d2-4ed5-b185-53aa103076b6","data":{"text":{"blocks":[{"key":"8m1sv","text":"Beim Training erlitt eine Klientin einen Hexenschuss.\r\nFrüher hatte sie oft Bandscheibenprobleme, seit der GienowMethode jedoch nicht mehr.","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}},{"key":"1h9h4","text":"Erst nahm sie aus Gewohnheit ein Schmerzmittel, dann erinnerte sie sich an die Fingergeste für Hexenschuss.","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}},{"key":"4mrc8","text":"\r\"Gudrun, du glaubst es nicht: Sofort waren die Schmerzen um 90% besser und am Abend ganz weg.\"\r\n","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}}],"entityMap":{}},"items":[]},"styles":{}}]},{"_id":"4b93471b-9166-4110-b826-5c7f5b243e04","type":"child","data":{},"styles":{},"moleculeModel":"grid","position":7,"children":[],"atoms":[{"_id":"cff84c9c-8576-481a-9086-fb6ed4a04835","type":"plain-text","parentId":"a999a13b-58d2-4ed5-b185-53aa103076b6","position":1,"data":{"text":{"blocks":[{"key":"8m1sv","text":"Ich bin am Wochenende nachts durch das Kribbeln einer sich ankündigenden Lippenherpes aufgewacht. Hab es dann gleich in mein Gesundheitskonto hochgeladen und die Fingergeste für Lippenherpes gehalten. Daraufhin konnte ich wieder einschlafen und am nächsten Tag verschwand das Lippenbläschen wieder","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}},{"key":"8vu8e","text":"- Georg P.","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}}],"entityMap":{}},"items":[]},"styles":{}}]},{"_id":"95473933-f0df-426f-9e9d-4e459e9e32cb","type":"child","data":{},"styles":{},"moleculeModel":"grid","position":8,"children":[],"atoms":[{"_id":"1f84faea-d365-4ac6-b5dd-f7b417128d08","type":"plain-text","parentId":"a999a13b-58d2-4ed5-b185-53aa103076b6","position":1,"data":{"text":{"blocks":[{"key":"8m1sv","text":"Ich bin ein großer Fan der Fingergesten, der Fingerapotheke, die ich häufig anwende und an Freunde und Familie weiter gegeben habe.\n","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}},{"key":"8vu8e","text":"- Sigrun","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}}],"entityMap":{}},"items":[]},"styles":{}}]}],"atoms":[{"_id":"a999a13b-58d2-4ed5-b185-53aa103076b6","position":1,"type":"plain-text","data":{"text":{"blocks":[{"key":"8m1sv","text":"Die große Überschrift","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}}],"entityMap":{}},"items":[]},"styles":{"font_type":"m","indentLg":16}}]}],"archivedMolecules":[]}]}]}},{"_id":"d9d6358c-15c6-4ad9-bf7b-d5024690183e","layout":"l11a","title":"CTA","data":{},"styles":{"layout_align":"center","color_bg":"white","padding_top":24,"padding_bottom":60,"padding_key":"xs","container_style_type":"transparent","full_height":false,"container_color_bg_type":"palette","container_color_bg":"light","animation_type":"off","animation_timing":"ease-out","animation